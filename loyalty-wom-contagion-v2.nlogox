<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [nw]

breed [shoppers shopper]

;; =========================================================
;; ПРИЗНАЧЕННЯ
;; =========================================================
;; Що залишається від поведінки покупця після завершення програми
;; лояльності, і що з цим робить word of mouth?
;;
;; Модель поєднує чотири механізми:
;;   винагорода    — зовнішній стимул під час кампанії;
;;   звичка        — повторення закріплює вибір;
;;   crowding out  — надто помітна винагорода витісняє внутрішню мотивацію;
;;   розмова       — досвід передається мережею й повертається у вибір.
;;
;; АРХІТЕКТУРА (модулі рівного рівня, жоден не викликає контролер):
;;   1) Контролер          — go, послідовність кроків;
;;   2) Розклад            — фази baseline / campaign / pause / final;
;;   3) Розмова            — хто говорить і що чує сусід;
;;   4) Рішення            — корисність -> імовірність вибору бренду;
;;   5) Поведінковий стан  — звичка та внутрішня мотивація;
;;   6) Досвід             — satisfaction відносно адаптивної точки відліку;
;;   7) Метрики            — накопичення та репортери для BehaviorSpace;
;;   8) Візуалізація.
;;
;; КЛЮЧОВЕ ПРОЄКТНЕ РІШЕННЯ. Усередині запуску немає control-групи.
;; Причина: при увімкненому WoM «контрольний» агент чує сусідів, які
;; отримують бонуси, тому він не є контролем. Усі порівняння —
;; МІЖ ЗАПУСКАМИ (program-on? та wom-on? як фактори). Через це розклад
;; фаз навмисно НЕ залежить від program-on?: прогон має однакову
;; довжину й однакову структуру вікон в усіх чотирьох клітинках
;; факторіалу, а вимкнена програма означає лише те, що під час
;; campaign-фази не нараховується винагорода.

globals [
  ;; ---- стан розкладу ----
  current-phase      ;; "baseline" | "campaign" | "pause" | "final"
  current-cycle      ;; номер кампанії, 0 під час baseline

  ;; ---- константи розкладу (не в UI) ----
  baseline-duration  ;; тіки спостереження до першої кампанії
  reward-duration    ;; тривалість однієї кампанії
  pause-duration     ;; пауза між кампаніями
  final-duration     ;; фінальне спостереження після останньої кампанії

  ;; ---- поведінкові константи (не в UI) ----
  habit-memory-window     ;; горизонт поведінкової пам'яті, тіки
  salience-threshold      ;; поріг, вище якого винагорода витісняє мотивацію
  motivation-gain         ;; масштаб зміни внутрішньої мотивації
  brand-price-premium     ;; відносна вартість бренду
  choice-sharpness        ;; крутизна логістичного правила вибору
  network-degree          ;; цільовий середній степінь вузла

  ;; ---- константи досвіду (не в UI) ----
  brand-experience        ;; базова якість покупки бренду
  rival-experience        ;; якість альтернативи
  reward-experience-bonus ;; внесок бонусу у відчуття від покупки
  reference-adapt         ;; швидкість адаптації точки відліку
  satisfaction-gain       ;; чутливість оцінки до відхилення від відліку
  satisfaction-memory     ;; інерція satisfaction
  baseline-liking         ;; постійний зсув оцінки; 0 навмисно.
                          ;; Будь-яке ненульове значення дає систематичний
                          ;; нахил, який через опуклість логістичної функції
                          ;; і зворотний зв'язок зі звичкою розганяється
                          ;; в лавину незалежно від програми.
  talk-margin             ;; |satisfaction|, з якого людині є що сказати.
                          ;; 0.40 підібрано так, щоб у стаціонарному стані
                          ;; майже ніхто не говорив: розмову породжують ЗМІНИ
                          ;; (старт і скасування кампанії), а не рівень.
                          ;; При малому значенні (0.10) канал сам собою
                          ;; насичує ринок ще під час baseline, і порівняння
                          ;; wom off / wom on вироджується.
  persistence-tolerance   ;; запас над baseline, який ще вважається «вище»

  ;; ---- накопичувачі метрик ----
  baseline-choices  baseline-ticks
  campaign-choices  campaign-ticks
  pause-choices     pause-ticks
  final-choices     final-ticks

  baseline-share-level     ;; частка вибору бренду за baseline-фазу
  baseline-habit-level     ;; середня звичка на кінець baseline
  initial-motivation-level ;; середня внутрішня мотивація на старті
  ticks-above-baseline     ;; тіки final-фази зі звичкою вище baseline
  collapse-tick            ;; перший тік final-фази, коли звичка впала; -1 = не впала
]

shoppers-own [
  ;; ---- поведінковий стан ----
  intrinsic-motivation   ;; [0;1] внутрішня цінність бренду для агента
  habit                  ;; [0;1] частка покупок бренду у вікні пам'яті
  recent-choices         ;; список 0/1 довжини habit-memory-window
  chose-brand?           ;; результат вибору на поточному тіку

  ;; ---- сталі індивідуальні риси (генеруються в setup) ----
  price-sensitivity
  habit-sensitivity
  reward-sensitivity
  autonomy-sensitivity   ;; наскільки болісно сприймається зовнішній контроль

  ;; ---- досвід і розмова ----
  satisfaction     ;; [-1;1] накопичена оцінка останніх покупок
  reference-level  ;; адаптивна точка відліку: до чого агент звик
  talking?         ;; чи говорить агент на цьому тіку
  stance           ;; 1 рекомендує, -1 відмовляє, 0 мовчить
  perceived-signal ;; [-1;1] що агент почув від сусідів цього тіку
]


;; =========================================================
;; ПАРАМЕТРИ ІНТЕРФЕЙСУ
;; =========================================================
;; Одинадцять контролів, згрупованих за призначенням.
;;
;; ПРОГРАМА
;;   number-of-shoppers    розмір популяції;
;;   reward-cycles         кількість кампаній;
;;   program-on?           чи нараховується винагорода взагалі;
;;   reward-salience       психологічна помітність бонусу, не його сума.
;;
;; РОЗМОВА
;;   wom-on?               чи існує канал word of mouth;
;;   talk-activity         імовірність, що агент, якому є що сказати,
;;                         справді говорить на цьому тіку;
;;   contagion-rule        "simple" — досить одного голосу;
;;                         "threshold" — потрібна критична частка сусідів;
;;   adoption-threshold    ця критична частка (діє лише для "threshold");
;;   talk-strength         вага почутого сигналу в корисності вибору.
;;
;; МЕРЕЖА
;;   network-topology      "small-world" | "preferential-attachment";
;;   rewiring-probability  частка перепідключених ребер (лише small-world).
;;
;; Усе інше — константи в initialize-constants та розподіли рис у
;; initialize-shopper. Їх свідомо не виведено в UI: вони визначають
;; масштаб моделі, а не сценарій політики.


;; =========================================================
;; ІНІЦІАЛІЗАЦІЯ
;; =========================================================

to initialize-constants
  set baseline-duration 50
  set reward-duration 40
  set pause-duration 20
  set final-duration 100

  set habit-memory-window 20
  set salience-threshold 0.60
  set motivation-gain 4.0
  set brand-price-premium 1.70
  set choice-sharpness 1.50
  set network-degree 8

  set brand-experience 0.30
  set rival-experience -0.10
  set reward-experience-bonus 0.50
  set reference-adapt 0.05
  set satisfaction-gain 2.0
  set satisfaction-memory 0.25
  set baseline-liking 0.00
  set talk-margin 0.40
  set persistence-tolerance 0.01
end


to setup
  clear-all
  initialize-constants
  validate-configuration
  no-display

  set current-phase "baseline"
  set current-cycle 0
  set baseline-choices 0   set baseline-ticks 0
  set campaign-choices 0   set campaign-ticks 0
  set pause-choices 0      set pause-ticks 0
  set final-choices 0      set final-ticks 0
  set baseline-share-level 0
  set baseline-habit-level 0
  set ticks-above-baseline 0
  set collapse-tick -1

  build-network

  set initial-motivation-level mean [intrinsic-motivation] of shoppers

  reset-ticks
  update-view
  display
end


;; Конфігурація перевіряється до створення агентів: модель або
;; запускається з коректним сценарієм, або одразу пояснює, що не так.
to validate-configuration
  if number-of-shoppers < 20 [
    error "number-of-shoppers must be at least 20"
  ]
  if number-of-shoppers != floor number-of-shoppers [
    error "number-of-shoppers must be an integer"
  ]
  if number-of-shoppers <= network-degree [
    error "number-of-shoppers must exceed the network degree (8)"
  ]
  if reward-cycles < 1 [
    error "reward-cycles must be at least 1 (use program-on? to switch the program off)"
  ]
  if reward-salience < 0 or reward-salience > 1 [
    error "reward-salience must be in [0, 1]"
  ]
  if talk-activity < 0 or talk-activity > 1 [
    error "talk-activity must be in [0, 1]"
  ]
  if adoption-threshold <= 0 or adoption-threshold > 1 [
    error "adoption-threshold must be in (0, 1]"
  ]
  if talk-strength < 0 [
    error "talk-strength must be non-negative"
  ]
  if rewiring-probability < 0 or rewiring-probability > 1 [
    error "rewiring-probability must be in [0, 1]"
  ]
  if not member? network-topology
    ["small-world" "preferential-attachment"] [
    error "network-topology must be small-world or preferential-attachment"
  ]
  if not member? contagion-rule ["simple" "threshold"] [
    error "contagion-rule must be simple or threshold"
  ]
end


;; Мережа статична в межах запуску. Генератори nw створюють агентів
;; і ребра одночасно, тому окремого повільного етапу створення links немає.
to build-network
  ;; Для Watts–Strogatz neighborhood-size — кількість сусідів з кожного
  ;; боку кільця, очікуваний степінь 2k. Для Barabási–Albert середній
  ;; степінь приблизно 2m. Обидва генератори дають однаковий цільовий
  ;; середній степінь, тому топології порівнянні за щільністю.
  let half-degree max list 1 floor (network-degree / 2)

  if network-topology = "small-world" [
    nw:generate-watts-strogatz
      shoppers links number-of-shoppers half-degree rewiring-probability
      [ initialize-shopper ]
  ]

  if network-topology = "preferential-attachment" [
    nw:generate-preferential-attachment
      shoppers links number-of-shoppers half-degree
      [ initialize-shopper ]
  ]

  nw:set-context shoppers links

  ;; Ребра не малюються: при 800 агентах і степені 8 це кілька тисяч
  ;; ліній, які нічого не показують і сильно сповільнюють вигляд.
  ask links [ set hidden? true ]
end


to initialize-shopper
  set shape "person"
  set size 0.7

  ;; Обрізані нормальні розподіли дають гетерогенну популяцію,
  ;; не породжуючи надлишку крайніх типів агентів.
  set intrinsic-motivation bounded-normal 0.50 0.15 0 1
  set price-sensitivity    bounded-normal 1.00 0.25 0.50 1.50
  set habit-sensitivity    bounded-normal 1.50 0.25 0.75 2.25
  set reward-sensitivity   bounded-normal 1.50 0.25 0.50 2.50
  set autonomy-sensitivity bounded-normal 0.50 0.20 0 1

  let starting-habit bounded-normal 0.22 0.10 0 1
  set recent-choices n-values habit-memory-window [
    ifelse-value (random-float 1 < starting-habit) [1] [0]
  ]
  set habit mean recent-choices

  set satisfaction bounded-normal 0 0.10 -1 1
  set reference-level 0
  set talking? false
  set stance 0
  set perceived-signal 0
  set chose-brand? false
end


;; =========================================================
;; КОНТРОЛЕР
;; =========================================================
;; Крок тіку розділений на три послідовні проходи по популяції.
;; Це модельне припущення, а не деталь реалізації: злиття проходів
;; в один ask зробило б результат залежним від випадкового порядку
;; агентів усередині ask.
;;   Прохід 1: хто цього тіку говорить і що саме.
;;   Прохід 2: кожен читає сусідів (усі стани зафіксовані проходом 1).
;;   Прохід 3: вибір і оновлення власного стану.

to go
  if simulation-finished? [ stop ]

  update-phase

  ask shoppers [ decide-to-talk ]
  ask shoppers [ set perceived-signal heard-signal ]
  ask shoppers [
    choose-brand
    update-habit
    update-motivation
    update-experience
  ]

  record-tick
  update-view
  tick
end


to-report simulation-finished?
  report ticks >= experiment-end
end


;; =========================================================
;; МОДУЛЬ РОЗКЛАДУ
;; =========================================================
;; Розклад НЕ залежить від program-on?. Вимкнена програма означає
;; нульову винагороду під час campaign-фази, а не коротший прогон.
;; Саме це робить факторіал program x wom коректним: усі чотири
;; клітинки мають однакову довжину прогону та однакові вікна метрик.

;; Програма ЗАВЕРШУЄТЬСЯ кампанією, а не паузою:
;; baseline | [campaign + pause] x (cycles - 1) | campaign | final
;; Інакше final-фаза починалася б після паузи, під час якої звичка вже
;; встигла обвалитися, і вимірювання тривалості утримання втрачало б сенс.
to-report program-window
  report (reward-cycles - 1) * (reward-duration + pause-duration)
       + reward-duration
end

to-report experiment-end
  report baseline-duration + program-window + final-duration
end

to-report phase-at [time]
  if time < baseline-duration [ report "baseline" ]

  let elapsed time - baseline-duration
  if elapsed >= program-window [ report "final" ]

  let cycle-length reward-duration + pause-duration
  ifelse (elapsed mod cycle-length) < reward-duration [
    report "campaign"
  ]
  [
    report "pause"
  ]
end

to-report cycle-at [time]
  if time < baseline-duration [ report 0 ]
  let elapsed time - baseline-duration
  let cycle-length reward-duration + pause-duration
  report min list reward-cycles (1 + floor (elapsed / cycle-length))
end

to update-phase
  set current-phase phase-at ticks
  set current-cycle cycle-at ticks
end

;; Єдина точка визначення поточної політики винагороди.
to-report active-reward-salience
  if not program-on? [ report 0 ]
  if current-phase != "campaign" [ report 0 ]
  report reward-salience
end


;; =========================================================
;; МОДУЛЬ РОЗМОВИ (WORD OF MOUTH)
;; =========================================================
;; Розмова — цілеспрямована дія (Berger, 2014): задоволений покупець
;; рекомендує, розчарований відмовляє. Обидва напрями симетричні:
;; venting — така сама функція обміну, як і похвала.
;;
;; talk-activity відокремлює НАЯВНІСТЬ думки від АКТУ її висловлення.
;; Агент говорить лише якщо (а) йому є що сказати, тобто |satisfaction|
;; перевищує talk-margin, і (б) випав його тік.

to decide-to-talk
  set talking? false
  set stance 0
  if not wom-on? [ stop ]
  if random-float 1 >= talk-activity [ stop ]

  if satisfaction > talk-margin [
    set talking? true
    set stance 1
    stop
  ]
  if satisfaction < (- talk-margin) [
    set talking? true
    set stance -1
  ]
end


;; Правило зараження визначає, коли почуте взагалі рахується.
;;
;; simple (Centola & Macy, 2007: проста контагія; Deutsch & Gerard, 1955:
;;   інформаційний маршрут) — одного голосу достатньо. Сигнал залежить
;;   лише від того, чи прозвучав хоч один голос кожного знаку.
;;
;; threshold (Granovetter, 1978; Watts, 2002: нормативний маршрут) —
;;   голос рахується, лише коли частка сусідів, що говорять у цей бік,
;;   перевищує adoption-threshold. Знаменник — УСІ сусіди, а не лише
;;   ті, хто говорить: тиск створює саме частка кола, а не частка
;;   висловлених думок.
;;
;; Обидва правила повертають значення в {-1, 0, 1}: два зустрічні
;; потоки гасять один одного, тому змішане коло дає нульовий сигнал.
to-report heard-signal
  if not wom-on? [ report 0 ]

  let neighborhood-size count link-neighbors
  if neighborhood-size = 0 [ report 0 ]

  let voices-for    count link-neighbors with [stance = 1]
  let voices-against count link-neighbors with [stance = -1]

  if contagion-rule = "simple" [
    report (ifelse-value (voices-for > 0) [1] [0])
         - (ifelse-value (voices-against > 0) [1] [0])
  ]

  report (ifelse-value (voices-for / neighborhood-size >= adoption-threshold) [1] [0])
       - (ifelse-value (voices-against / neighborhood-size >= adoption-threshold) [1] [0])
end


;; =========================================================
;; МОДУЛЬ ПРИЙНЯТТЯ РІШЕННЯ
;; =========================================================
;; Корисність вибору бренду:
;;
;;   U_i = m_i + s^h_i h_i + s^r_i r + w g_i - s^p_i c
;;
;;   m    intrinsic-motivation (вага жорстко 1: інакше модель вироджена)
;;   s^h  habit-sensitivity,  h  habit
;;   s^r  reward-sensitivity, r  active-reward-salience
;;   w    talk-strength,      g  perceived-signal   (0 при wom-on? = false)
;;   s^p  price-sensitivity,  c  brand-price-premium
;;
;; Соціальний доданок асимілятивний: сигнал тягне агента туди, куди
;; тягне його оточення (Flache et al., 2017).
;;
;; ІДЕНТИФІКОВАНІСТЬ. choice-sharpness множить усю U, тому спільне
;; масштабування всіх ваг дає ту саму модель. При калібруванні
;; фіксуйте choice-sharpness і шукайте решту.

to choose-brand
  set chose-brand? random-float 1 < logistic (choice-sharpness * brand-utility)
end

to-report brand-utility
  report intrinsic-motivation
    + habit-sensitivity * habit
    + reward-sensitivity * active-reward-salience
    + social-contribution
    - price-sensitivity * brand-price-premium
end

to-report social-contribution
  if not wom-on? [ report 0 ]
  report talk-strength * perceived-signal
end


;; =========================================================
;; МОДУЛЬ ПОВЕДІНКОВОГО СТАНУ
;; =========================================================

;; Звичка — ковзна частка покупок бренду у скінченному вікні пам'яті.
;; Вона формується виключно повторенням, тому окремі habit-learning-rate
;; і habit-decay-rate не потрібні: обидва задані довжиною вікна.
to update-habit
  set recent-choices
    fput (ifelse-value chose-brand? [1] [0]) (but-last recent-choices)
  set habit mean recent-choices
end


;; CROWDING OUT.
;;
;;   signal = G * r * (theta - r) / W
;;
;;   r > 0    винагорода фактично нарахована
;;   theta    salience-threshold
;;   G        motivation-gain, W habit-memory-window
;;
;; Одна формула дає обидва режими: помірний бонус (r < theta) підтверджує
;; цінність поведінки, надмірний (r > theta) сприймається як зовнішній
;; контроль і витісняє внутрішню мотивацію.
;;
;; Множник r у чисельнику є істотним. Без нього нульова винагорода дає
;; НАЙБІЛЬШЕ позитивне підкріплення (theta - 0 = theta), тобто відсутність
;; стимулу максимально зміцнює мотивацію. Тут signal(0) = 0: немає бонусу —
;; немає ефекту бонусу.
;;
;; Підкріплення множиться на (1 - m), витіснення — на m, тому обидва
;; процеси насичуються біля меж [0; 1]. Індивідуальна autonomy-sensitivity
;; діє лише на витіснення: люди по-різному переносять контроль, але
;; однаково приймають підтвердження.
;;
;; ПЕРЕДУМОВИ: винагорода активна І агент справді купив бренд.
;; Поза цим мотивація не змінюється — модель не має механізму
;; самостійного відновлення мотивації, і це свідоме обмеження:
;; витіснення тут незворотне в межах прогону.
to update-motivation
  let salience active-reward-salience
  if salience <= 0 [ stop ]
  if not chose-brand? [ stop ]

  let signal motivation-gain * salience * (salience-threshold - salience)
             / habit-memory-window

  ifelse signal >= 0 [
    set intrinsic-motivation
      clamp (intrinsic-motivation + signal * (1 - intrinsic-motivation)) 0 1
  ]
  [
    set intrinsic-motivation
      clamp (intrinsic-motivation
             + autonomy-sensitivity * signal * intrinsic-motivation) 0 1
  ]
end


;; =========================================================
;; МОДУЛЬ ДОСВІДУ
;; =========================================================
;; Satisfaction вимірює не абсолютну якість покупки, а відхилення від
;; того, до чого агент ЗВИК. reference-level — адаптивна точка відліку,
;; повільне середнє минулого досвіду.
;;
;; Саме звідси береться післяпрограмне розчарування. Під час кампанії
;; точка відліку піднімається до рівня «покупка + бонус». Коли програму
;; скасовано, той самий товар без бонусу опиняється НИЖЧЕ звичного рівня,
;; satisfaction падає в мінус, і мережею йде хвиля негативних відгуків.
;; Без адаптивного відліку скасування бонусу дало б лише повернення до
;; помірно позитивної оцінки, і механізму розчарування не існувало б.
to update-experience
  let experience rival-experience
  if chose-brand? [
    set experience brand-experience
      + reward-experience-bonus * active-reward-salience
  ]

  set reference-level
    reference-level + reference-adapt * (experience - reference-level)

  let evaluation clamp
    (satisfaction-gain * (experience - reference-level) + baseline-liking)
    -1 1

  ;; Шум відображає варіативність обслуговування та суб'єктивного сприйняття.
  set satisfaction clamp
    (satisfaction
     + satisfaction-memory * (evaluation + random-normal 0 0.05 - satisfaction))
    -1 1
end


;; =========================================================
;; МОДУЛЬ МЕТРИК: НАКОПИЧЕННЯ
;; =========================================================

to record-tick
  let population count shoppers
  let buyers count shoppers with [chose-brand?]
  let habit-level mean [habit] of shoppers

  if current-phase = "baseline" [
    set baseline-choices baseline-choices + buyers
    set baseline-ticks baseline-ticks + 1
    set baseline-share-level
      baseline-choices / (population * baseline-ticks)
    ;; Рівень звички на кінець baseline — опорна лінія для persistence.
    set baseline-habit-level habit-level
  ]

  if current-phase = "campaign" [
    set campaign-choices campaign-choices + buyers
    set campaign-ticks campaign-ticks + 1
  ]

  if current-phase = "pause" [
    set pause-choices pause-choices + buyers
    set pause-ticks pause-ticks + 1
  ]

  if current-phase = "final" [
    set final-choices final-choices + buyers
    set final-ticks final-ticks + 1

    ;; ТРИВАЛІСТЬ, а не лише рівень. Питання експерименту 2 —
    ;; «чи розмова тримає звичку вище baseline ДОВШЕ». Порівнюється
    ;; середня звичка, а не миттєва частка покупок: звичка вже є
    ;; ковзним середнім за 20 тіків, тому не потребує згладжування
    ;; і не породжує хибних перетинів через шум вибірки.
    ifelse habit-level > baseline-habit-level + persistence-tolerance [
      set ticks-above-baseline ticks-above-baseline + 1
    ]
    [
      if collapse-tick = -1 [ set collapse-tick final-ticks ]
    ]
  ]
end


;; =========================================================
;; МОДУЛЬ МЕТРИК: РЕПОРТЕРИ
;; =========================================================

to-report current-brand-share
  if not any? shoppers [ report 0 ]
  report count shoppers with [chose-brand?] / count shoppers
end

to-report brand-share [phase-name]
  let population count shoppers
  if population = 0 [ report 0 ]

  if phase-name = "baseline" [
    report safe-rate baseline-choices (population * baseline-ticks)
  ]
  if phase-name = "campaign" [
    report safe-rate campaign-choices (population * campaign-ticks)
  ]
  if phase-name = "pause" [
    report safe-rate pause-choices (population * pause-ticks)
  ]
  if phase-name = "final" [
    report safe-rate final-choices (population * final-ticks)
  ]
  report 0
end


;; ПІДЙОМ ПРОГРАМИ: наскільки campaign-фаза підняла частку бренду
;; відносно власного baseline того самого запуску. Для експерименту 1
;; порівнюються значення цього репортера між запусками з wom-on? false і true.
to-report program-lift
  report brand-share "campaign" - brand-share "baseline"
end

;; PERSISTENCE INDEX: чи тримається поведінка вище baseline після
;; завершення програми. > 0 залишок є; = 0 повернення до baseline; < 0 нижче.
to-report persistence-index
  report brand-share "final" - brand-share "baseline"
end

;; Яка частка досягнутого під час кампанії рівня збереглася.
to-report retention-ratio
  report safe-rate (brand-share "final") (brand-share "campaign")
end

to-report withdrawal-drop
  report brand-share "campaign" - brand-share "final"
end

;; Скільки тіків final-фази звичка протрималася вище baseline.
;; Разом із ticks-to-collapse відповідає на «довше чи ні».
to-report ticks-to-collapse
  if collapse-tick = -1 [ report final-duration ]
  report collapse-tick
end

to-report mean-habit
  if not any? shoppers [ report 0 ]
  report mean [habit] of shoppers
end

to-report habit-spread
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [habit] of shoppers
end

to-report mean-motivation
  if not any? shoppers [ report 0 ]
  report mean [intrinsic-motivation] of shoppers
end

;; Скільки внутрішньої мотивації втрачено відносно старту прогону.
;; Додатне значення = crowding out відбувся.
to-report motivation-loss
  report initial-motivation-level - mean-motivation
end

to-report mean-satisfaction
  if not any? shoppers [ report 0 ]
  report mean [satisfaction] of shoppers
end

;; Частка тих, хто рекомендує САМЕ ЗАРАЗ (говорить на цьому тіку).
to-report share-recommending
  if not any? shoppers [ report 0 ]
  report count shoppers with [stance = 1] / count shoppers
end

to-report share-advising-against
  if not any? shoppers [ report 0 ]
  report count shoppers with [stance = -1] / count shoppers
end

;; Частка тих, кому Є ЩО сказати, незалежно від того, чи випав їм голос.
;; Стабільніша за share-recommending, бо не залежить від talk-activity.
to-report share-satisfied
  if not any? shoppers [ report 0 ]
  report count shoppers with [satisfaction > talk-margin] / count shoppers
end

to-report share-dissatisfied
  if not any? shoppers [ report 0 ]
  report count shoppers with [satisfaction < (- talk-margin)] / count shoppers
end

;; Частка агентів, які цього тіку отримали ненульовий сигнал.
;; Показує, чи канал взагалі працює при заданому adoption-threshold.
to-report share-reached
  if not any? shoppers [ report 0 ]
  report count shoppers with [perceived-signal != 0] / count shoppers
end

to-report mean-network-degree
  if not any? shoppers [ report 0 ]
  report mean [count link-neighbors] of shoppers
end


;; =========================================================
;; МОДУЛЬ ВІЗУАЛІЗАЦІЇ
;; =========================================================
;; Позиція агента кодує його стан, а не місце в мережі:
;; X = внутрішня мотивація, Y = сила звички. Розшарування хмари по Y
;; означає, що популяція поділилася на лояльну та нелояльну групи.
;; Колір — поточна роль у розмові.

to update-view
  ask shoppers [
    setxy
      clamp (scale-to-world intrinsic-motivation min-pxcor max-pxcor) min-pxcor max-pxcor
      clamp (scale-to-world habit min-pycor max-pycor) min-pycor max-pycor

    if stance = 1  [ set color green ]
    if stance = -1 [ set color red ]
    if stance = 0  [ set color gray ]

    set size ifelse-value chose-brand? [1] [0.55]
  ]
end

to-report scale-to-world [value minimum maximum]
  report minimum + value * (maximum - minimum)
end


;; =========================================================
;; ДОПОМІЖНІ ФУНКЦІЇ
;; =========================================================

to-report safe-rate [numerator denominator]
  if denominator = 0 [ report 0 ]
  report numerator / denominator
end

to-report logistic [value]
  ;; Обмеження аргументу запобігає переповненню exp().
  report 1 / (1 + exp (- (clamp value -20 20)))
end

to-report clamp [value minimum maximum]
  report max list minimum (min list maximum value)
end

to-report bounded-normal [mean-value deviation minimum maximum]
  report clamp (random-normal mean-value deviation) minimum maximum
end
]]></code>
