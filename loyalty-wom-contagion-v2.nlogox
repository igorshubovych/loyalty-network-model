  <experiments>
    <experiment name="E1 amplification - does talk raise the program lift" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed behaviorspace-run-number
setup</setup>
      <go>go</go>
      <exitCondition>simulation-finished?</exitCondition>
      <metrics>
        <metric>brand-share "baseline"</metric>
        <metric>brand-share "campaign"</metric>
        <metric>brand-share "pause"</metric>
        <metric>brand-share "final"</metric>
        <metric>program-lift</metric>
        <metric>persistence-index</metric>
        <metric>retention-ratio</metric>
        <metric>withdrawal-drop</metric>
        <metric>ticks-above-baseline</metric>
        <metric>ticks-to-collapse</metric>
        <metric>mean-habit</metric>
        <metric>habit-spread</metric>
        <metric>mean-motivation</metric>
        <metric>motivation-loss</metric>
        <metric>mean-satisfaction</metric>
        <metric>share-recommending</metric>
        <metric>share-advising-against</metric>
        <metric>share-satisfied</metric>
        <metric>share-dissatisfied</metric>
        <metric>share-reached</metric>
        <metric>mean-network-degree</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-shoppers">
          <value value="800"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-cycles">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="program-on?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-salience">
          <value value="0.75"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wom-on?">
          <value value="false"></value>
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="talk-activity">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="contagion-rule">
          <value value="&quot;simple&quot;"></value>
          <value value="&quot;threshold&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="adoption-threshold">
          <value value="0.15"></value>
          <value value="0.35"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="talk-strength">
          <value value="0.5"></value>
          <value value="1.5"></value>
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="network-topology">
