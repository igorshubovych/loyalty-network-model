  <experiments>
    <experiment name="E1 Amplification" repetitions="40" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed behaviorspace-run-number
setup</setup>
      <go>go</go>
      <exitCondition>simulation-finished?</exitCondition>
      <metrics>
        <metric>baseline-choice-rate</metric>
        <metric>campaign-choice-rate</metric>
        <metric>late-choice-rate</metric>
        <metric>campaign-lift</metric>
        <metric>retention</metric>
        <metric>mean-habit</metric>
        <metric>mean-opinion</metric>
        <metric>mean-intrinsic-motivation</metric>
        <metric>share-locked-in</metric>
        <metric>share-locked-out</metric>
        <metric>habit-standard-deviation</metric>
        <metric>habit-assortativity</metric>
        <metric>degree-standard-deviation</metric>
        <metric>wom-receiver-share</metric>
        <metric>mean-network-degree</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="reward-salience">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-weight">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="confidence-bound">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="conformity-weight">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="network-topology">
          <value value="&quot;small-world&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="network-degree">
          <value value="8"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="factorial-replicates">
          <value value="6"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="program-on?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wom-on?">
          <value value="false"></value>
          <value value="true"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
