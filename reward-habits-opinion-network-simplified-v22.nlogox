<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [nw]

breed [shoppers shopper]

;; =========================================================
;; МОДЕЛЬ v21 — СПРОЩЕНА
;; =========================================================
;;
;; Залишено рівно чотири механізми:
;;   1) МОДЕЛЬ ЗНАЧУЩОСТІ ВИНАГОРОДИ (salience) — винагорода нижче порогу
;;      підтримує внутрішню мотивацію, вище порогу витісняє її;
;;   2) ФОРМУВАННЯ ЗВИЧКИ — частка цільових виборів у скінченному вікні;
;;   3) ДИНАМІКА ДУМОК — власний досвід плюс bounded-confidence усереднення
;;      думок сусідів (Hegselmann-Krause);
;;   4) СТРУКТУРА МЕРЕЖІ — хто чий сусід, плюс локальна конформність, через
;;      яку структура взагалі здатна впливати на результат.
;;
;; Усе інше згорнуто в константи. Порівняно з v18 прибрано: поділ на
;; control/treatment усередині прогону, зважування думок за ступенем,
;; поріг складного зараження, перемикач впливу винагороди на
;; satisfaction. Багатоциклову структуру кампанії (v20) навпаки
;; повернуто з v18: три цикли reward/withdrawal замість одного.
;; Вибір початкового розподілу думок (`initial-opinion-distribution`)
;; теж було прибрано разом з рештою, а згодом повернуто окремим
;; запитом — це єдиний з відрізаних контролів, доданий назад.
;;
;; КЛЮЧОВА ЗМІНА ДИЗАЙНУ. У v18 контрольна група жила в одному прогоні з
;; піддослідною і чула її думки, тому не була чистою базою для порівняння.
;; Тут уся популяція отримує одну умову, а порівняння виконується МІЖ
;; ПРОГОНАМИ за схемою 2x2 (програма ввімк/вимк) x (розмови ввімк/вимк).
;; Довжина прогону однакова в усіх чотирьох умовах, тому траєкторії
;; можна накладати одна на одну потикно.
;;
;; ФАЗИ (v20: три цикли, як у v18)
;;   baseline    ticks 0..29                спостереження без програми
;;   campaign 1  ticks 30..89                програма активна, якщо program-on?
;;   withdrawal 1 ticks 90..189              пауза між кампаніями
;;   campaign 2  ticks 190..249
;;   withdrawal 2 ticks 250..349
;;   campaign 3  ticks 350..409
;;   withdrawal 3 ticks 410..509             фінальне спостереження
;;
;; Довжина одного циклу (campaign + withdrawal) стала для всіх трьох
;; циклів — і для пауз МІЖ кампаніями, і для фінального спостереження
;; після останньої. Це саме те спрощення, яке зробив v18: одна константа
;; withdrawal-duration обслуговує обидві ролі.
;;
;; Фази існують незалежно від program-on?. Коли програму вимкнено, жодна
;; з трьох фаз campaign не має винагороди, але мітки фаз і їхні межі в
;; часі лишаються тими самими. Це навмисно: усі чотири умови факторного
;; порівняння мають лишатися вирівняними в часі.


globals [
  ;; Поточна фаза: "baseline", "campaign" або "withdrawal".
  current-phase

  ;; Номер поточного циклу кампанії: 0 під час baseline, 1..program-cycles
  ;; під час campaign/withdrawal відповідного циклу.
  current-cycle

  ;; Частка цільових виборів на кожному tick, від нульового до поточного.
  ;; Це єдиний накопичувач результатів у моделі: усі три експерименти
  ;; є контрастами середніх по фазах, тому окремі лічильники на агента
  ;; не потрібні.
  choice-rate-history
]


shoppers-own [
  ;; --- МЕХАНІЗМ 1: значущість винагороди ---
  ;; Внутрішня мотивація [0; 1]. Єдина змінна, яку програма лояльності
  ;; здатна пошкодити назавжди.
  intrinsic-motivation

  ;; Чутливість до втрати автономії [0; 1]: наскільки боляче агент
  ;; сприймає надто значущу винагороду як зовнішній контроль.
  autonomy-sensitivity

  ;; --- МЕХАНІЗМ 2: звичка ---
  ;; Сила звички [0; 1] = частка цільових виборів у вікні пам'яті.
  habit
  recent-choice-history

  ;; --- МЕХАНІЗМ 3: думка ---
  ;; Накопичене ставлення до цільового вибору [-1; 1].
  opinion

  ;; Оцінка останньої покупки [-1; 1]. Миттєва, історії не має.
  satisfaction

  ;; Індивідуальна швидкість оновлення думки власним досвідом.
  opinion-update-rate

  ;; Буфери синхронного bounded-confidence кроку. Без них оновлення
  ;; залежало б від порядку агентів усередині ask.
  previous-opinion
  next-opinion
  received-wom-count

  ;; --- МЕХАНІЗМ 4: мережа ---
  ;; Частка сусідів, які обрали ціль на попередньому tick. Єдиний канал,
  ;; яким ПОВЕДІНКА сусіда впливає на агента; думка передається окремо.
  neighbor-target-share

  ;; --- сталі характеристики та результат кроку ---
  price-sensitivity
  habit-sensitivity
  reward-sensitivity
  chose-target?
]


;; =========================================================
;; КОНСТАНТИ
;; =========================================================
;;
;; Оформлені як репортери, а не як globals, з двох причин: їх не може
;; стерти clear-all (це критично для процедури run-factorial, яка
;; викликає setup у циклі), і значення видно поруч із поясненням.
;;
;; Значення підібрані так, щоб система працювала БІЛЯ ТОЧКИ ПЕРЕЛОМУ:
;; звичка сама себе не утримує після скасування програми, але й не зникає
;; миттєво. Саме в цьому режимі другий і третій експерименти мають
;; недегенеровану відповідь. Якщо зробити target-choice-cost меншим,
;; популяція залипає в цільовій поведінці назавжди і скасування програми
;; ні на що не впливає; якщо більшим — програма не встигає створити звичку.

to-report population-size          report 300  end
to-report baseline-duration        report 30   end
to-report campaign-duration        report 60   end
to-report withdrawal-duration      report 100  end

;; Кількість циклів кампанії (v20, повернуто з v18). Не винесено в UI:
;; це деталь розкладу, а не один із чотирьох механізмів моделі, тому
;; лишається константою, як і всі інші довжини фаз.
to-report program-cycles           report 3    end

to-report total-duration
  report baseline-duration
    + program-cycles * (campaign-duration + withdrawal-duration)
end

;; Довжина вікна пам'яті звички. Задає і темп формування звички,
;; і темп її згасання: звичка не може змінитися швидше, ніж за 20 ticks.
to-report habit-memory-window      report 20   end

;; Поріг значущості винагороди. Нижче — підтримка внутрішньої мотивації,
;; вище — витіснення. Це і є вся модель значущості.
to-report salience-threshold       report 0.60 end

;; Стала незручність цільового вибору (ціна, час, зусилля).
;; Головний параметр калібрування: визначає базовий рівень і те,
;; чи здатна звичка утримувати себе без винагороди.
to-report target-choice-cost       report 1.05 end

;; Крутизна логістичного вибору. Вище — рішучіші агенти.
to-report choice-sharpness         report 3    end

;; Швидкість, з якою власний досвід зсуває думку.
to-report opinion-memory-rate      report 0.05 end

;; Очікуваний досвід від НЕцільового вибору. Від'ємний, тому популяція
;; без програми повільно накопичує невдоволення — це джерело негативних
;; розмов у сценарії "лише розмови".
to-report non-target-experience    report -0.25 end

;; Очікуваний досвід від цільового вибору без винагороди
;; та надбавка, пропорційна значущості винагороди.
to-report target-experience        report 0.25 end
to-report reward-experience-gain   report 0.45 end

;; Імовірність перез'єднання для топології small-world.
to-report rewiring-probability     report 0.10 end


;; =========================================================
;; КОНТРОЛЕР СИМУЛЯЦІЇ
;; =========================================================

to setup
  clear-all
  no-display

  validate-configuration

  set current-phase "baseline"
  set current-cycle 0
  set choice-rate-history []

  setup-network

  reset-ticks
  update-visualization
  display
end


to validate-configuration
  if reward-salience < 0 or reward-salience > 1 [
    error "reward-salience must be in the range [0, 1]"
  ]

  if opinion-weight < 0 [
    error "opinion-weight must be non-negative"
  ]

  if conformity-weight < 0 [
    error "conformity-weight must be non-negative"
  ]

  if confidence-bound <= 0 [
    error "confidence-bound must be positive"
  ]

  if network-degree < 2 [
    error "network-degree must be at least 2"
  ]
end


to go
  if simulation-finished? [ stop ]

  set current-phase phase-at ticks
  set current-cycle cycle-at ticks

  ask shoppers [ perform-shopper-step ]

  ;; Знімок робиться після того, як УСІ агенти зробили вибір, тому
  ;; конформність читає узгоджений стан тіку і не залежить від порядку
  ;; агентів усередині ask.
  update-neighbor-snapshot

  perform-opinion-dynamics-step

  set choice-rate-history lput current-choice-rate choice-rate-history
  update-visualization
  tick
end


to run-to-end
  while [not simulation-finished?] [ go ]
end


to-report simulation-finished?
  report ticks >= total-duration
end


;; Циклічний розклад: після baseline йдуть program-cycles повторень
;; (campaign, withdrawal) однакової довжини. Одна й та сама
;; withdrawal-duration слугує і паузою між кампаніями, і фінальним
;; спостереженням після останньої — так само, як у v18.
to-report phase-at [time]
  if time < baseline-duration [ report "baseline" ]

  let elapsed time - baseline-duration
  let cycle-length campaign-duration + withdrawal-duration
  let position-in-cycle elapsed mod cycle-length

  if position-in-cycle < campaign-duration [ report "campaign" ]
  report "withdrawal"
end


;; Номер циклу (1..program-cycles) для тику. 0 під час baseline.
to-report cycle-at [time]
  if time < baseline-duration [ report 0 ]

  let elapsed time - baseline-duration
  let cycle-length campaign-duration + withdrawal-duration
  report 1 + floor (elapsed / cycle-length)
end


;; Значущість винагороди, що діє на агента просто зараз.
;; Нуль поза фазою кампанії та за вимкненої програми.
to-report active-salience
  if not program-on? [ report 0 ]
  if current-phase != "campaign" [ report 0 ]
  report reward-salience
end


;; =========================================================
;; ПОБУДОВА ПОПУЛЯЦІЇ ТА МЕРЕЖІ
;; =========================================================

to setup-network
  let neighborhood-size max list 1 floor (network-degree / 2)

  if network-topology = "ring-lattice" [
    nw:generate-watts-strogatz shoppers links
      population-size neighborhood-size 0 [ initialize-shopper ]
  ]

  if network-topology = "small-world" [
    nw:generate-watts-strogatz shoppers links
      population-size neighborhood-size rewiring-probability
      [ initialize-shopper ]
  ]

  if network-topology = "preferential-attachment" [
    nw:generate-preferential-attachment shoppers links
      population-size neighborhood-size [ initialize-shopper ]
  ]

  nw:set-context shoppers links

  ;; Агенти розкладаються по колу в порядку who. У ring-lattice сусіди по
  ;; мережі є сусідами і на колі, тому локальні домени видно як суцільні
  ;; дуги одного кольору. У preferential-attachment такої відповідності
  ;; немає, і дуг не виникає — це найпростіший спосіб побачити топологію.
  layout-circle sort shoppers (max-pxcor - 2)

  ;; Напівпрозорі зв'язки: структура видно, але вузли не тонуть у ній.
  ask links [ set color [110 110 110 25] ]
end


to initialize-shopper
  set shape "default"

  ;; Обрізані нормальні розподіли дають неоднорідну популяцію без
  ;; надмірної кількості крайніх типів.
  set intrinsic-motivation bounded-random-normal 0.5 0.15 0 1
  set autonomy-sensitivity bounded-random-normal 0.5 0.20 0 1

  set price-sensitivity bounded-random-normal 1.0 0.25 0.5 1.5
  set habit-sensitivity bounded-random-normal 0.8 0.20 0.4 1.2
  set reward-sensitivity bounded-random-normal 1.0 0.25 0.5 1.5

  ;; Початкова думка задається chooser-ом initial-opinion-distribution.
  ;; Дефолт "normal-around-0" відтворює попередню (жорстко зашиту)
  ;; поведінку в точності, тож старі результати без цього параметра
  ;; лишаються відтворюваними.
  set opinion initial-opinion-draw
  set satisfaction bounded-random-normal 0 0.10 -1 1

  set opinion-update-rate bounded-random-normal
    opinion-memory-rate
    (0.40 * opinion-memory-rate)
    (0.20 * opinion-memory-rate)
    (2.50 * opinion-memory-rate)

  set previous-opinion opinion
  set next-opinion opinion
  set received-wom-count 0
  set neighbor-target-share 0.5

  ;; Початкова історія виборів узгоджена з початковою силою звички.
  let initial-habit bounded-random-normal 0.2 0.1 0 1
  set recent-choice-history n-values habit-memory-window [
    ifelse-value (random-float 1 < initial-habit) [1] [0]
  ]
  set habit mean recent-choice-history

  set chose-target? false
end


;; Генерує початкове opinion покупця відповідно до розподілу, вибраного
;; в інтерфейсі (`initial-opinion-distribution`). Перенесено з v19 без
;; змін. "normal-around-0" — гілка за замовчуванням і водночас гілка,
;; куди потрапляє будь-яке нерозпізнане значення (захист для старих
;; збережених файлів моделі, де цього chooser-а ще не було).
to-report initial-opinion-draw
  if initial-opinion-distribution = "uniform" [
    report random-float 2 - 1
  ]

  if initial-opinion-distribution = "bimodal" [
    ;; Половина популяції починає з помірно позитивної, а половина — з помірно негативної думки.
    let camp-center ifelse-value (random 2 = 0) [0.4] [-0.4]
    report bounded-random-normal camp-center 0.15 -1 1
  ]

  if initial-opinion-distribution = "all-neutral" [
    report 0
  ]

  report bounded-random-normal 0 0.15 -1 1
end


;; =========================================================
;; КРОК АГЕНТА
;; =========================================================

to perform-shopper-step
  choose-behavior
  update-habit
  update-intrinsic-motivation
  update-satisfaction

  if wom-on? [ update-opinion-from-experience ]
end


to choose-behavior
  set chose-target? random-float 1 < target-choice-probability
end


to-report target-choice-probability
  report logistic (choice-sharpness * target-choice-utility)
end


;; Корисність цільового вибору:
;;
;;   U = m + s_h * h + s_r * r + w * o + g * (n - 0.5) - s_p * c
;;
;;   m    внутрішня мотивація (неявна вага 1)
;;   s_h  чутливість до звички,      h  сила звички
;;   s_r  чутливість до винагороди,  r  активна значущість
;;   w    opinion-weight,            o  думка          (0 при wom-on? = false)
;;   g    conformity-weight,         n  частка сусідів (0 при g = 0)
;;   s_p  цінова чутливість,         c  target-choice-cost
to-report target-choice-utility
  report intrinsic-motivation
    + habit-sensitivity * habit
    + reward-sensitivity * active-salience
    + opinion-term
    + conformity-term
    - price-sensitivity * target-choice-cost
end


to-report opinion-term
  if not wom-on? [ report 0 ]
  report opinion-weight * opinion
end


;; Локальна конформність. Це єдина причина, з якої топологія мережі
;; взагалі здатна впливати на результат: усереднення думок є стисненням
;; і структури не створює, а цей доданок утворює локальний позитивний
;; зворотний зв'язок. Центрування на 0.5 означає, що рівно поділене
;; оточення не зміщує рішення в жоден бік.
to-report conformity-term
  if conformity-weight = 0 [ report 0 ]
  report conformity-weight * (neighbor-target-share - 0.5)
end


;; =========================================================
;; МЕХАНІЗМ 2: ЗВИЧКА
;; =========================================================

to update-habit
  set recent-choice-history
    fput (ifelse-value chose-target? [1] [0]) (but-last recent-choice-history)
  set habit mean recent-choice-history
end


;; =========================================================
;; МЕХАНІЗМ 1: ЗНАЧУЩІСТЬ ВИНАГОРОДИ
;; =========================================================
;;
;; Мотивація змінюється лише тоді, коли агент отримав винагороду, тобто
;; зробив цільовий вибір під час активної кампанії. Знак зміни визначає
;; порівняння значущості з порогом.
;;
;; Обидва ефекти поділені на habit-memory-window, щоб зміна мотивації
;; відбувалася в тому самому часовому масштабі, що й зміна звички.
to update-intrinsic-motivation
  let salience active-salience
  if salience = 0 [ stop ]
  if not chose-target? [ stop ]

  ifelse salience <= salience-threshold [
    ;; Помірна винагорода читається як визнання: вона підтягує мотивацію
    ;; до одиниці, і тим сильніше, чим нижча вона зараз.
    let reinforcement
      (salience-threshold - salience)
      * (1 - intrinsic-motivation)
      / habit-memory-window

    set intrinsic-motivation
      clamp (intrinsic-motivation + reinforcement) 0 1
  ]
  [
    ;; Надмірна винагорода читається як зовнішній контроль: вона з'їдає
    ;; наявну мотивацію пропорційно чутливості агента до втрати автономії.
    let motivation-loss
      autonomy-sensitivity
      * (salience - salience-threshold)
      * intrinsic-motivation
      / habit-memory-window

    set intrinsic-motivation
      clamp (intrinsic-motivation - motivation-loss) 0 1
  ]
end


;; =========================================================
;; МЕХАНІЗМ 3: ДОСВІД І ДУМКА
;; =========================================================

to update-satisfaction
  let expected non-target-experience

  if chose-target? [
    set expected target-experience + reward-experience-gain * active-salience
  ]

  set satisfaction clamp (random-normal expected 0.15) -1 1
end


to update-opinion-from-experience
  set opinion clamp
    (opinion + opinion-update-rate * (satisfaction - opinion))
    -1 1
end


;; Канонічний крок Hegselmann-Krause на мережі: агент усереднює власну
;; думку з думками тих сусідів, чия думка відрізняється не більше ніж на
;; confidence-bound. Крок синхронний і є опуклою комбінацією, тому не
;; здатен вивести думки за межі наявного діапазону — він може лише
;; звужувати розкид.
to perform-opinion-dynamics-step
  ask shoppers [
    set previous-opinion opinion
    set next-opinion opinion
    set received-wom-count 0
  ]

  if not wom-on? [ stop ]

  ask shoppers [
    let focal-agent self
    let focal-opinion previous-opinion

    let accepted-neighbors link-neighbors with [
      abs (previous-opinion - [previous-opinion] of focal-agent)
        <= confidence-bound
    ]

    set received-wom-count count accepted-neighbors

    set next-opinion
      (focal-opinion + sum [previous-opinion] of accepted-neighbors)
      / (1 + received-wom-count)
  ]

  ask shoppers [ set opinion clamp next-opinion -1 1 ]
end


;; =========================================================
;; МЕХАНІЗМ 4: ЗНІМОК ПОВЕДІНКИ СУСІДІВ
;; =========================================================
;;
;; Детермінований прохід, ГВЧ не споживає. Ізольований агент бачить
;; нейтральне 0.5, щоб відсутність сусідів не читалася як оточення,
;; що повністю відмовилося від цільового вибору.
to update-neighbor-snapshot
  ask shoppers [
    let peers link-neighbors

    ifelse any? peers [
      set neighbor-target-share
        mean [ifelse-value chose-target? [1] [0]] of peers
    ]
    [ set neighbor-target-share 0.5 ]
  ]
end


;; =========================================================
;; МЕТРИКИ
;; =========================================================

;; "campaign (cycle 2)" / "withdrawal (cycle 2)" / "baseline". Показує
;; водночас фазу й номер циклу в одному моніторі, щоб не займати два.
to-report condition-and-cycle
  if current-cycle = 0 [ report current-phase ]
  report (word current-phase " (cycle " current-cycle ")")
end


to-report current-choice-rate
  if not any? shoppers [ report 0 ]
  report (count shoppers with [chose-target?]) / (count shoppers)
end


;; Середня частка цільових виборів на проміжку ticks [from; to).
to-report mean-rate-between [from to-tick]
  let available length choice-rate-history
  let start-index min list from available
  let end-index min list to-tick available
  if end-index <= start-index [ report 0 ]
  report mean sublist choice-rate-history start-index end-index
end


to-report baseline-choice-rate
  report mean-rate-between 0 baseline-duration
end


;; Середня частка цільових виборів по УСІХ тіках фази campaign, з усіх
;; трьох циклів разом. На відміну від baseline-choice-rate та
;; late-choice-rate, ці тіки більше не утворюють один суцільний проміжок,
;; тому mean-rate-between (діапазон) тут не підходить — потрібен прохід
;; по фазах через mean-rate-in-phase.
to-report campaign-choice-rate
  report mean-rate-in-phase "campaign"
end


;; Середня частка цільових виборів по всіх тіках, де phase-at = phase-name.
;; Використовується для campaign-choice-rate: обчислює phase-at наново
;; для кожного тику, а не читає окремий журнал фаз, щоб не заводити
;; ще один список поруч із choice-rate-history.
to-report mean-rate-in-phase [phase-name]
  let available length choice-rate-history
  let matched-total 0
  let matched-count 0
  let time 0

  while [time < available] [
    if phase-at time = phase-name [
      set matched-total matched-total + item time choice-rate-history
      set matched-count matched-count + 1
    ]
    set time time + 1
  ]

  if matched-count = 0 [ report 0 ]
  report matched-total / matched-count
end


;; Останні 30 ticks фази скасування: стан, у якому система заспокоїлася.
to-report late-choice-rate
  report mean-rate-between (total-duration - 30) total-duration
end


;; ЕКСПЕРИМЕНТ 1. Підйом, який дала кампанія відносно власного базового
;; рівня цього ж прогону.
to-report campaign-lift
  report campaign-choice-rate - baseline-choice-rate
end


;; ЕКСПЕРИМЕНТ 2. Скільки підйому лишилося через 100 ticks після
;; скасування програми, відносно власного базового рівня.
to-report retention
  report late-choice-rate - baseline-choice-rate
end


to-report mean-habit
  if not any? shoppers [ report 0 ]
  report mean [habit] of shoppers
end


to-report mean-opinion
  if not any? shoppers [ report 0 ]
  report mean [opinion] of shoppers
end


to-report opinion-standard-deviation
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [opinion] of shoppers
end


to-report mean-intrinsic-motivation
  if not any? shoppers [ report 0 ]
  report mean [intrinsic-motivation] of shoppers
end


to-report share-locked-in
  if not any? shoppers [ report 0 ]
  report (count shoppers with [habit >= 0.7]) / (count shoppers)
end


to-report share-locked-out
  if not any? shoppers [ report 0 ]
  report (count shoppers with [habit <= 0.3]) / (count shoppers)
end


to-report habit-standard-deviation
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [habit] of shoppers
end


;; Частка агентів, які прийняли хоча б одну думку сусіда на цьому tick.
;; Якщо вона близька до нуля, соціального кроку фактично немає:
;; confidence-bound надто малий.
to-report wom-receiver-share
  if not any? shoppers [ report 0 ]
  report (count shoppers with [received-wom-count > 0]) / (count shoppers)
end


to-report mean-network-degree
  if not any? shoppers [ report 0 ]
  report mean [count link-neighbors] of shoppers
end


;; Розкид ступенів. Головна вісь, уздовж якої відрізняються топології:
;; ring-lattice дає рівно 0, preferential-attachment — велике значення,
;; хоча середній ступінь у моделі вирівняний між топологіями за дизайном.
to-report degree-standard-deviation
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [count link-neighbors] of shoppers
end


;; Середня різниця звички по всіх невпорядкованих парах популяції.
;; Обчислюється зі сортованого списку за O(N log N) і, на відміну від
;; вибірки через one-of, НЕ споживає ГВЧ: метрика не має права зсувати
;; послідовність генератора.
to-report mean-pairwise-habit-difference
  let n count shoppers
  if n < 2 [ report 0 ]

  let values sort [habit] of shoppers
  let weighted-total 0
  let index 0

  while [index < n] [
    set weighted-total weighted-total + (2 * index - n + 1) * item index values
    set index index + 1
  ]

  report weighted-total / (n * (n - 1) / 2)
end


;; Наскільки схожі сусіди порівняно з випадковою парою. Близько нуля —
;; просторової структури немає, і топологія впливати не може.
to-report habit-assortativity
  if not any? links [ report 0 ]

  let random-difference mean-pairwise-habit-difference
  if random-difference = 0 [ report 0 ]

  report 1 - (mean [abs ([habit] of end1 - [habit] of end2)] of links)
              / random-difference
end


;; =========================================================
;; ФАКТОРНИЙ ІНСТРУМЕНТ 2x2
;; =========================================================
;;
;; Усі три експерименти є МІЖ-ПРОГОННИМИ контрастами, тому одного прогону
;; для них принципово недостатньо. Ця процедура виконує всі чотири умови
;; по factorial-replicates разів із ПАРНИМИ seed-ами: репліка номер k
;; стартує з того самого seed у всіх чотирьох умовах, тому різницю не
;; можна списати на різні випадкові прогони.
;;
;; ЗАСТЕРЕЖЕННЯ
;;   1. Кожен прогін викликає setup, тобто clear-all. Локальні змінні
;;      процедури це переживають, а глобальні й графіки — ні, тому
;;      побудова графіків виконується наприкінці з накопичених списків.
;;      З цієї ж причини всі константи оформлені як репортери.
;;   2. Після завершення в світі лишається стан останнього прогону, а
;;      перемикачі відновлюються. Перед інтерактивною роботою натисніть
;;      setup — це очистить факторні графіки.
to run-factorial
  let conditions [
    ["neither"      false false]
    ["program only" true  false]
    ["talk only"    false true ]
    ["program+talk" true  true ]
  ]

  let original-program program-on?
  let original-wom wom-on?

  ;; Кожен запис: [мітка траєкторія base campaign late base-SD late-SD]
  let summary []
  let condition-index 0

  while [condition-index < length conditions] [
    let condition item condition-index conditions
    set program-on? item 1 condition
    set wom-on? item 2 condition

    let trajectory-sum n-values total-duration [0]
    let base-values []
    let campaign-values []
    let late-values []
    let replicate 1

    while [replicate <= factorial-replicates] [
      random-seed (20000 + replicate)
      setup
      run-to-end

      set trajectory-sum
        (map [[running-total tick-rate] -> running-total + tick-rate]
             trajectory-sum choice-rate-history)

      set base-values lput baseline-choice-rate base-values
      set campaign-values lput campaign-choice-rate campaign-values
      set late-values lput late-choice-rate late-values

      set replicate replicate + 1
    ]

    set summary lput
      (list (item 0 condition)
            (map [total -> total / factorial-replicates] trajectory-sum)
            (mean base-values)
            (mean campaign-values)
            (mean late-values)
            (spread-of late-values))
      summary

    print (word "completed: " item 0 condition)
    set condition-index condition-index + 1
  ]

  set program-on? original-program
  set wom-on? original-wom

  draw-factorial-plots summary
  print-factorial-summary summary
end


to-report spread-of [values]
  if length values < 2 [ report 0 ]
  report standard-deviation values
end


;; Пошук рядка умови за міткою. Порядок в summary збігається з порядком
;; conditions, але пошук за міткою робить код стійким до змін порядку.
to-report condition-row [summary condition-label]
  report first filter [row -> item 0 row = condition-label] summary
end


to-report late-of [summary condition-label]
  report item 4 condition-row summary condition-label
end

to-report base-of [summary condition-label]
  report item 2 condition-row summary condition-label
end

to-report campaign-of [summary condition-label]
  report item 3 condition-row summary condition-label
end

to-report lift-of [summary condition-label]
  report (campaign-of summary condition-label) - (base-of summary condition-label)
end


to draw-factorial-plots [summary]
  ;; Траєкторії: чотири лінії, накладені потикно.
  set-current-plot "Factorial: choice rate over time"
  clear-plot

  let row-index 0
  while [row-index < length summary] [
    let row item row-index summary
    set-current-plot-pen item 0 row

    let trajectory item 1 row
    let time 0
    while [time < length trajectory] [
      plotxy time item time trajectory
      set time time + 1
    ]

    set row-index row-index + 1
  ]

  ;; ЕКСПЕРИМЕНТ 1. Підйом під час кампанії з розмовами та без них.
  set-current-plot "Factorial: campaign lift"
  clear-plot
  set-current-plot-pen "program only"
  plotxy 1 lift-of summary "program only"
  set-current-plot-pen "program+talk"
  plotxy 2 lift-of summary "program+talk"

  ;; ЕКСПЕРИМЕНТ 3. Утримання відносно умови "neither", і додатковий
  ;; стовпчик — сума окремих ефектів. Якщо стовпчик "both" вищий за
  ;; "additive benchmark", канали доповнюють один одного; якщо нижчий —
  ;; замінюють.
  let reference late-of summary "neither"
  let program-effect (late-of summary "program only") - reference
  let talk-effect (late-of summary "talk only") - reference
  let both-effect (late-of summary "program+talk") - reference

  set-current-plot "Factorial: retention after cancellation"
  clear-plot
  set-current-plot-pen "program only"
  plotxy 1 program-effect
  set-current-plot-pen "talk only"
  plotxy 2 talk-effect
  set-current-plot-pen "program+talk"
  plotxy 3 both-effect
  set-current-plot-pen "additive benchmark"
  plotxy 4 (program-effect + talk-effect)
end


to print-factorial-summary [summary]
  print (word "replicates per condition: " factorial-replicates
              "   (paired seeds)")
  print "condition       baseline  campaign      late      lift  late SD"

  let row-index 0
  while [row-index < length summary] [
    let row item row-index summary
    print (word
      pad-right (item 0 row) 16
      pad-left (precision (item 2 row) 3) 9
      pad-left (precision (item 3 row) 3) 10
      pad-left (precision (item 4 row) 3) 10
      pad-left (precision ((item 3 row) - (item 2 row)) 3) 10
      pad-left (precision (item 5 row) 3) 9)
    set row-index row-index + 1
  ]

  let lift-alone lift-of summary "program only"
  let lift-with-talk lift-of summary "program+talk"
  print ""
  print (word "E1 AMPLIFICATION  program lift " (precision lift-alone 3)
              " -> with talk " (precision lift-with-talk 3)
              "   ratio "
              (ifelse-value (lift-alone = 0)
                ["n/a"]
                [precision (lift-with-talk / lift-alone) 2]))

  let decay-alone
    (campaign-of summary "program only") - (late-of summary "program only")
  let decay-with-talk
    (campaign-of summary "program+talk") - (late-of summary "program+talk")
  print (word "E2 PERSISTENCE    drop after cancellation "
              (precision decay-alone 3) " without talk, "
              (precision decay-with-talk 3) " with talk")

  let reference late-of summary "neither"
  let program-effect (late-of summary "program only") - reference
  let talk-effect (late-of summary "talk only") - reference
  let both-effect (late-of summary "program+talk") - reference
  let gap both-effect - (program-effect + talk-effect)
  print (word "E3 SUBSTITUTION   program " (precision program-effect 3)
              ", talk " (precision talk-effect 3)
              ", both " (precision both-effect 3)
              ", additive " (precision (program-effect + talk-effect) 3)
              "  -> "
              (ifelse-value (gap > 0) ["COMPLEMENTS"] ["SUBSTITUTES"])
              " (gap " (precision gap 3) ")")
end


to-report pad-right [value width]
  let text word value ""
  while [length text < width] [ set text word text " " ]
  report text
end


to-report pad-left [value width]
  let text word value ""
  while [length text < width] [ set text word " " text ]
  report text
end


;; =========================================================
;; ВІЗУАЛІЗАЦІЯ
;; =========================================================
;;
;; Позиції задані один раз у setup через layout-circle і далі не
;; змінюються, тому видно саме мережу. Колір кодує думку, розмір — звичку.
to update-visualization
  ask shoppers [
    set color ifelse-value (opinion >= 0)
      [ scale-color green opinion 1.6 -0.2 ]
      [ scale-color red (- opinion) 1.6 -0.2 ]

    set size 0.8 + 2.2 * habit
  ]
end


;; =========================================================
;; ДОПОМІЖНІ ФУНКЦІЇ
;; =========================================================

to-report logistic [value]
  report 1 / (1 + exp (- clamp value -20 20))
end


to-report clamp [value minimum maximum]
  report max list minimum (min list maximum value)
end


to-report bounded-random-normal [mean-value deviation minimum maximum]
  report clamp (random-normal mean-value deviation) minimum maximum
end
