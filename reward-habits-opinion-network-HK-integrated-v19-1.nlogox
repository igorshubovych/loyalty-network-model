  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="regression-test" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed 12345
setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= experiment-end]]></exitCondition>
      <metrics>
        <metric>treatment-post-reward-effect</metric>
        <metric>final-withdrawal-choice-rate "control"</metric>
        <metric>final-withdrawal-choice-rate "treatment"</metric>
        <metric>mean-intrinsic-motivation "treatment"</metric>
        <metric>mean-habit "treatment"</metric>
        <metric>persistence "control"</metric>
        <metric>persistence "treatment"</metric>
        <metric>persistence-index "control"</metric>
        <metric>persistence-index "treatment"</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-shoppers">
          <value value="900"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-cycles">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-duration">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal-duration">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="choice-sharpness">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-memory-rate">
          <value value="0.25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="non-target-experience">
          <value value="-0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-affects-satisfaction?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wom-on?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="network-topology">
          <value value="&quot;preferential-attachment&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="network-degree">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="rewiring-probability">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="confidence-bound">
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-weight">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-opinion-distribution">
          <value value="&quot;normal-around-0&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-salience">
          <value value="0.9"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="conformity-weight">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reinforcement-threshold">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-leader-weighting?">
          <value value="false"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="E1 reward magnitude and post-reward effect" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed behaviorspace-run-number
setup</setup>
      <go>go</go>
      <exitCondition>simulation-finished?</exitCondition>
      <metrics>
        <metric>choice-rate "control" "baseline"</metric>
        <metric>choice-rate "treatment" "baseline"</metric>
        <metric>choice-rate "control" "reward"</metric>
        <metric>choice-rate "treatment" "reward"</metric>
        <metric>persistence "control"</metric>
        <metric>persistence "treatment"</metric>
        <metric>persistence-index "control"</metric>
        <metric>persistence-index "treatment"</metric>
        <metric>mean-intrinsic-motivation "control"</metric>
        <metric>mean-intrinsic-motivation "treatment"</metric>
        <metric>mean-habit "control"</metric>
        <metric>mean-habit "treatment"</metric>
        <metric>treatment-post-reward-effect</metric>
        <metric>treatment-withdrawal-drop</metric>
        <metric>treatment-retention-ratio</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-shoppers">
          <value value="1200"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-cycles">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-duration">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal-duration">
          <value value="80"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="choice-sharpness">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-memory-rate">
          <value value="0.25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="non-target-experience">
          <value value="-0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-affects-satisfaction?">
          <value value="true"></value>
          <value value="false"></value>
