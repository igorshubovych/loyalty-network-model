<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [nw]

breed [shoppers shopper]

;; =========================================================
;; ОГОЛОШЕННЯ МОДЕЛІ
;; =========================================================
;;
;; Модель розділена на незалежні логічні модулі:
;; 1) Контролер симуляції — керує послідовністю виконання;
;; 2) Модуль розкладу винагород — визначає активність бонусної програми;
;; 3) Модуль прийняття рішення покупцем — обчислює імовірність вибору;
;; 4) Модуль поведінкового стану — оновлює звичку та мотивацію;
;; 5) Модуль досвіду та думки — формує satisfaction та opinion;
;; 6) Модуль мережі та динаміки думок — створює мережу та виконує імовірнісне bounded-confidence оновлення;
;; 7) Модуль метрик — накопичує й повертає результати;
;; 8) Модуль візуалізації — відображає стан агентів.
;;
;; Така структура дозволяє замінювати або додавати поведінкові
;; механізми без переписування основного циклу симуляції.

globals [
  ;; Поточний режим програми лояльності:
  ;; "baseline"   — початкове спостереження без бонусів;
  ;; "reward"     — бонусна програма активна;
  ;; "withdrawal" — бонусна програма призупинена або завершена.
  current-phase

  ;; Номер поточного бонусного циклу.
  ;; 0 означає baseline або сценарій без бонусної програми.
  current-cycle

  ;; Кількість виконаних ticks кожного типу фази.
  ;; Withdrawal розділено на паузи між кампаніями та фінальний період
  ;; після завершення всієї програми. Ці лічильники глобальні, оскільки
  ;; кожний shopper має рівно одну можливість вибору на кожному tick.
  baseline-ticks-completed
  reward-ticks-completed
  inter-cycle-withdrawal-ticks-completed
  final-withdrawal-ticks-completed

  ;; Константи
  baseline-duration
  habit-memory-window
  salience-threshold
  target-choice-cost
]


shoppers-own [
  ;; Експериментальна група:
  ;; "control", "low-salience" або "high-salience".
  treatment-group

  ;; Внутрішня мотивація [0; 1].
  ;; Відображає внутрішню цінність цільової поведінки для покупця,
  ;; незалежно від зовнішньої винагороди.
  intrinsic-motivation

  ;; Сила звички [0; 1], обчислена як частка цільових виборів
  ;; у скінченному вікні нещодавньої поведінки.
  habit

  ;; Сталі індивідуальні характеристики агента.
  ;; Вони генеруються під час setup і не задаються через UI.
  price-sensitivity
  habit-sensitivity
  reward-sensitivity

  ;; Чутливість до втрати автономії [0; 1]: наскільки сильно агент
  ;; сприймає надмірно значущу винагороду як зовнішній контроль.
  autonomy-sensitivity

  ;; Історія останніх виборів: 1 — цільовий вибір, 0 — альтернативний.
  recent-choice-history

  ;; Результат вибору на поточному tick.
  ;; true — цільовий сталий/здоровий варіант обрано.
  chose-target?

  ;; Оцінка останньої взаємодії [-1; 1]. Satisfaction є миттєвим
  ;; результатом конкретної покупки та не накопичує історію самостійно.
  satisfaction

  ;; Накопичене ставлення до цільового вибору / програми [-1; 1].
  ;; Воно формується власним досвідом і повідомленнями сусідів.
  opinion

  ;; Чутливість opinion до нового власного досвіду.
  opinion-update-rate

  ;; Стан для синхронного probabilistic bounded-confidence update.
  ;; previous-opinion фіксує стан на початку соціального кроку;
  ;; next-opinion обчислюється без використання частково оновлених думок.
  previous-opinion
  next-opinion

  ;; Кількість думок сусідів, прийнятих агентом на поточному tick.
  received-wom-count

  ;; Фактична зміна opinion, спричинена мережевим оновленням.
  wom-opinion-change

  ;; Кількість цільових виборів у кожному типі фази.
  ;; Reward агрегується за всі активні кампанії, а withdrawal окремо
  ;; зберігається для проміжних пауз і фінального спостереження.
  baseline-target-choices
  reward-target-choices
  inter-cycle-withdrawal-target-choices
  final-withdrawal-target-choices
]


;; =========================================================
;; ПАРАМЕТРИ ІНТЕРФЕЙСУ: СЕМАНТИЧНИЙ І ПОВЕДІНКОВИЙ ЗМІСТ
;; =========================================================
;;
;; Вхідні параметри утворюють п'ять конфігураційних груп.
;; Така класифікація відокремлює технічний масштаб симуляції,
;; розклад бонусної програми, політику винагороди та поведінкові
;; припущення конкретної моделі агентів та соціальну мережу.
;;
;; КОНФІГУРАЦІЯ СИМУЛЯЦІЇ
;;
;; number-of-shoppers
;;   Розмір модельованої популяції. Збільшення значення зменшує
;;   випадкові коливання агрегованих показників, але збільшує час роботи.
;;
;; КОНФІГУРАЦІЯ РОЗКЛАДУ ВИНАГОРОД
;;
;; reward-cycles
;;   Кількість бонусних кампаній.
;;   0 — бонусна програма не запускається;
;;   1 — одна кампанія;
;;   >1 — повторні кампанії з паузами між ними.
;;
;; reward-duration
;;   Тривалість активного бонусного періоду в одному циклі, у ticks.
;;   Один tick інтерпретується як одна можливість здійснити вибір.
;;
;; withdrawal-duration
;;   Тривалість періоду без бонусів після кожної кампанії, у ticks.
;;   Між циклами це пауза, а після останнього циклу — фінальний період
;;   спостереження за стійкістю поведінки.
;;
;; КОНФІГУРАЦІЯ ПОЛІТИКИ ВИНАГОРОД
;;
;; low-reward-salience / high-reward-salience
;;   Психологічна значущість (reward salience), а не номінальна сума
;;   винагороди. Значення визначає, наскільки зовнішній стимул помітний
;;   у процесі прийняття рішення. Параметри задають політику винагороди
;;   для двох treatment-груп.
;;
;; КОНФІГУРАЦІЯ ПОВЕДІНКОВОЇ МОДЕЛІ
;;
;; Індивідуальні властивості shopper не задаються через UI. Під час
;; setup для кожного агента генеруються price-sensitivity,
;; habit-sensitivity, reward-sensitivity та autonomy-sensitivity.
;; Звичка визначається історією повторень, тому окремий
;; habit-learning-rate не використовується. Ерозія внутрішньої
;; мотивації визначається значущістю винагороди та індивідуальною
;; autonomy-sensitivity, тому crowding-out-rate також не потрібний.

;; =========================================================
;; КОНСТАНТИ МОДЕЛІ
;; =========================================================
;; Іменовані reporters нижче є незмінними припущеннями конкретної
;; реалізації моделі. Вони не є динамічним станом і не задаються в UI.

;; Кількість останніх можливостей вибору, що визначають поточну звичку.
;; Це інтерпретований горизонт поведінкової пам'яті, а не швидкість навчання.
;; Параметри розподілів індивідуальних властивостей shopper.
;; Середні значення habit/reward sensitivity зберігають масштаб впливів
;; попередньої версії моделі, але тепер агенти є неоднорідними.

;; =========================================================
;; ІНІЦІАЛІЗАЦІЯ
;; =========================================================

to initialize-constants
  set baseline-duration 30
  set habit-memory-window 20
  set salience-threshold 0.60
  set target-choice-cost 1.50
end


to setup
  clear-all
  initialize-constants
  no-display

  ;; Перевірка контракту вхідної конфігурації виконується до створення
  ;; агентів. Некоректний сценарій завершується з пояснювальною помилкою.
  validate-configuration

  initialize-system-state

  ;; NW одночасно створює агентів і зв'язки потрібної топології.
  ;; Це усуває окремий повільний етап ручного створення links.
  setup-social-network

  ;; M4. Експериментальні групи призначаються після побудови мережі,
  ;; щоб належність до групи не залежала від позиції агента в мережі.
  assign-treatment-groups

  reset-ticks
  update-simulation-state
  update-visualization
  display
end


;; Перевіряє семантичні обмеження UI та BehaviourSpace-параметрів.
;; Валідація є частиною зовнішнього контракту симуляційного ядра:
;; модель або запускається з коректною конфігурацією, або одразу
;; повідомляє, яке саме обмеження порушено.
to validate-configuration
  if opinion-weight < 0 [
    error "opinion-weight must be non-negative."
  ]

  if number-of-shoppers < 3 [
    error "number-of-shoppers must be at least 3"
  ]

  if number-of-shoppers != floor number-of-shoppers [
    error "number-of-shoppers must be an integer"
  ]

  if reward-cycles < 0 [
    error "reward-cycles cannot be negative"
  ]

  if reward-cycles != floor reward-cycles [
    error "reward-cycles must be an integer"
  ]

  if reward-cycles > 0 and reward-duration <= 0 [
    error "reward-duration must be positive when reward-cycles > 0"
  ]

  if withdrawal-duration <= 0 [
    error "withdrawal-duration must be positive"
  ]

  if low-reward-salience < 0 or low-reward-salience > 1 [
    error "low-reward-salience must be in the range [0, 1]"
  ]

  if high-reward-salience < 0 or high-reward-salience > 1 [
    error "high-reward-salience must be in the range [0, 1]"
  ]

  if low-reward-salience > high-reward-salience [
    error "low-reward-salience cannot exceed high-reward-salience"
  ]

  if network-degree < 2 [
    error "network-degree must be at least 2"
  ]

  if network-degree >= number-of-shoppers [
    error "network-degree must be smaller than number-of-shoppers"
  ]

  if rewiring-probability < 0 or rewiring-probability > 1 [
    error "rewiring-probability must be in the range [0, 1]"
  ]

  if confidence-bound <= 0 or confidence-bound > 2 [
    error "confidence-bound must be in the range (0, 2]"
  ]

  if acceptance-facilitation < 0 or acceptance-facilitation > 1 [
    error "acceptance-facilitation must be in the range [0, 1]"
  ]

  if baseline-acceptance < 0 or baseline-acceptance > 1 [
    error "baseline-acceptance must be in the range [0, 1]"
  ]

  if opinion-mutation-rate < 0 or opinion-mutation-rate > 1 [
    error "opinion-mutation-rate must be in the range [0, 1]"
  ]

  ;; Перевірки параметрів, доданих у версії v13.
  if choice-sharpness <= 0 [
    error "choice-sharpness must be positive"
  ]

  if opinion-memory-rate <= 0 or opinion-memory-rate > 1 [
    error "opinion-memory-rate must be in the range (0, 1]"
  ]

  if non-target-experience < -1 or non-target-experience > 1 [
    error "non-target-experience must be in the range [-1, 1]"
  ]

end

to initialize-system-state
  set baseline-ticks-completed 0
  set reward-ticks-completed 0
  set inter-cycle-withdrawal-ticks-completed 0
  set final-withdrawal-ticks-completed 0
end

to initialize-shopper-state
  set shape "person"
  set size 0.7

  ;; Обрізані нормальні розподіли створюють гетерогенну популяцію,
  ;; зберігаючи значення психологічних станів у діапазоні [0; 1].
  set intrinsic-motivation bounded-random-normal 0.5 0.15 0 1

  let initial-habit bounded-random-normal 0.2 0.1 0 1

  ;; Поведінкові характеристики генеруються з обрізаних нормальних
  ;; розподілів. Це уникає надмірної кількості крайніх типів агентів.
  set price-sensitivity bounded-random-normal 1 0.25 0.5 1.5
  set habit-sensitivity bounded-random-normal 1.5 0.25 0.75 2.25
  set reward-sensitivity bounded-random-normal 2 0.25 1 3
  set autonomy-sensitivity bounded-random-normal 0.5 0.2 0 1

  ;; Початковий satisfaction майже нейтральний. Початковий opinion
  ;; тепер задається chooser-ом initial-opinion-distribution, щоб можна
  ;; було стартувати з різних форм громадської думки.
  set satisfaction bounded-random-normal 0 0.10 -1 1
  set opinion initial-opinion-draw
  ;; M2. Середня швидкість оновлення opinion тепер задається параметром.
  ;; Низьке значення робить opinion повільною пам'яттю минулого досвіду,
  ;; а не відображенням останньої покупки. Розкид і межі масштабуються
  ;; разом із середнім, щоб зберігати неоднорідність популяції.
  set opinion-update-rate bounded-random-normal
    opinion-memory-rate
    (0.40 * opinion-memory-rate)
    (0.20 * opinion-memory-rate)
    (min list 0.95 (2.50 * opinion-memory-rate))

  set previous-opinion opinion
  set next-opinion opinion
  set received-wom-count 0
  set wom-opinion-change 0

  ;; Початкова історія узгоджується з початковою силою звички.
  set recent-choice-history n-values habit-memory-window [
    ifelse-value (random-float 1 < initial-habit) [1] [0]
  ]
  set habit mean recent-choice-history

  set chose-target? false
  set baseline-target-choices 0
  set reward-target-choices 0
  set inter-cycle-withdrawal-target-choices 0
  set final-withdrawal-target-choices 0
end


;; M4. Групи призначаються після створення мережі зі випадково
;; перемішаного списку міток, тому належність до групи статистично
;; не залежить від позиції в мережі. У v12 діяло правило `who mod 3`,
;; а генератори `nw` будують мережу в порядку створення агентів, тому
;; група була пов'язана з позицією: кожна кільцева околиця містила
;; по одному агенту кожної групи, а три початкові хаби
;; preferential-attachment також належали до різних груп. Це змішувало впливи.
;;
;; Чистий baseline без програми виконується окремим запуском із
;; `reward-cycles = 0`, у якому жодна група не отримує винагороди.
to assign-treatment-groups
  let group-labels []
  let slot-index 0

  repeat count shoppers [
    set group-labels lput
      (item (slot-index mod 3)
        ["control" "low-salience" "high-salience"])
      group-labels
    set slot-index slot-index + 1
  ]

  set group-labels shuffle group-labels

  (foreach (sort shoppers) group-labels [
    [the-shopper the-label] ->
      ask the-shopper [ set treatment-group the-label ]
  ])

  ask shoppers [ apply-treatment-color ]
end


to apply-treatment-color
  if treatment-group = "control" [ set color (lime - 3) ]
  if treatment-group = "low-salience" [ set color cyan ]
  if treatment-group = "high-salience" [ set color red ]
end


;; =========================================================
;; МОДУЛЬ СОЦІАЛЬНОЇ МЕРЕЖІ
;; =========================================================
;; Соціальна мережа є статичною в межах одного запуску.
;; Її топологію створюють стандартні генератори розширення NW.
;; Це скорочує код, гарантує відповідність відомим алгоритмам
;; і пришвидшує setup порівняно з поетапним створенням links.

to setup-social-network
  ;; Захист від некоректного значення після відкриття старішої версії.
  if not member? network-topology
    ["small-world" "ring-lattice" "random" "preferential-attachment"] [
    set network-topology "small-world"
  ]

  ;; Для Watts–Strogatz neighborhood-size означає кількість сусідів
  ;; з кожного боку кільця. Очікуваний degree дорівнює 2k.
  let neighborhood-size max list 1 floor (network-degree / 2)

  if network-topology = "ring-lattice" [
    ;; Регулярна кільцева ґратка: Watts–Strogatz без перепідключення.
    nw:generate-watts-strogatz
      shoppers links number-of-shoppers neighborhood-size 0
      [ initialize-generated-shopper ]
  ]

  if network-topology = "small-world" [
    ;; Класична small-world топологія Watts–Strogatz.
    nw:generate-watts-strogatz
      shoppers links number-of-shoppers neighborhood-size rewiring-probability
      [ initialize-generated-shopper ]
  ]

  if network-topology = "random" [
    ;; Erdős–Rényi G(n,p). p підібрано так, щоб очікуваний
    ;; середній degree приблизно дорівнював network-degree.
    let connection-probability
      min list 1 (network-degree / (number-of-shoppers - 1))

    nw:generate-random
      shoppers links number-of-shoppers connection-probability
      [ initialize-generated-shopper ]
  ]

  if network-topology = "preferential-attachment" [
    ;; Barabási–Albert. Середній degree приблизно дорівнює 2m.
    let minimum-degree max list 1 floor (network-degree / 2)

    nw:generate-preferential-attachment
      shoppers links number-of-shoppers minimum-degree
      [ initialize-generated-shopper ]
  ]

  ;; Явний контекст потрібен для подальших NW-метрик та аналізу.
  nw:set-context shoppers links

  ;; Розміщення впливає лише на вигляд, а не на WOM.
  layout-circle shoppers (max-pxcor - 1)
end


;; Генерує початкове opinion покупця відповідно до розподілу,
;; вибраного в інтерфейсі. `normal-around-0` відтворює попередню
;; поведінку та використовується за замовчуванням і для старіших файлів.
to-report initial-opinion-draw
  if initial-opinion-distribution = "uniform" [
    report random-float 2 - 1
  ]

  if initial-opinion-distribution = "bimodal" [
    ;; Половина популяції починає з помірно позитивної, а половина — з помірно негативної думки.
    let camp-center ifelse-value (random 2 = 0) [0.4] [-0.4]
    report bounded-random-normal camp-center 0.15 -1 1
  ]

  if initial-opinion-distribution = "all-neutral" [
    report 0
  ]

  report bounded-random-normal 0 0.15 -1 1
end


;; Значення habit, нижче якого перебуває частка p покупців. Квантили p10 і p90
;; разом показують, чи популяція однорідна, чи поділена на дві групи:
;; при поділі p10 лишається низьким, а p90 — високим.
to-report habit-percentile [p]
  if not any? shoppers [ report 0 ]
  let vals sort [habit] of shoppers
  report item (floor (p * (length vals - 1))) vals
end


;; NW виконує цей блок для кожного щойно створеного агента.
;; Група більше не призначається тут; див. `assign-treatment-groups`,
;; яка виконується після повного створення мережі.
to initialize-generated-shopper
  initialize-shopper-state
end


;; =========================================================
;; КОНТРОЛЕР СИМУЛЯЦІЇ
;; =========================================================
;; Верхньорівневий алгоритм не містить поведінкових формул.
;; Він лише координує виклик незалежних модулів.

to go
  if simulation-finished? [ stop ]

  update-simulation-state

  ;; Усі агенти спочатку завершують вибір і оновлення власного стану.
  ;; Лише після цього виконується WOM, щоб результат не залежав від
  ;; випадкового порядку агентів усередині ask.
  ask shoppers [
    perform-shopper-step
  ]

  perform-social-opinion-dynamics-step

  record-system-state
  update-visualization
  tick
end


to-report simulation-finished?
  report ticks >= experiment-end
end


to update-simulation-state
  set current-phase phase-at ticks
  set current-cycle cycle-at ticks
end


;; =========================================================
;; МОДУЛЬ РОЗКЛАДУ ВИНАГОРОД
;; =========================================================
;; Модуль визначає лише часову структуру програми. Він не знає,
;; як саме винагорода впливає на рішення або психологічний стан агента.

to-report experiment-end
  if reward-cycles <= 0 [
    report baseline-duration + withdrawal-duration
  ]

  report baseline-duration
    + reward-cycles * (reward-duration + withdrawal-duration)
end


to-report phase-at [time]
  if time < baseline-duration [
    report "baseline"
  ]

  ;; reward-cycles = 0: після baseline виконується лише контрольний
  ;; період без бонусів.
  if reward-cycles <= 0 [
    report "withdrawal"
  ]

  let elapsed time - baseline-duration
  let cycle-length reward-duration + withdrawal-duration
  let position-in-cycle elapsed mod cycle-length

  if position-in-cycle < reward-duration [
    report "reward"
  ]

  report "withdrawal"
end


to-report cycle-at [time]
  if time < baseline-duration or reward-cycles <= 0 [
    report 0
  ]

  let elapsed time - baseline-duration
  let cycle-length reward-duration + withdrawal-duration
  let cycle-number 1 + floor (elapsed / cycle-length)

  report min list reward-cycles cycle-number
end


to-report reward-active?
  report current-phase = "reward"
end

;; true лише для пауз між бонусними кампаніями.
to-report inter-cycle-withdrawal?
  report current-phase = "withdrawal"
    and reward-cycles > 1
    and current-cycle < reward-cycles
end

;; true для періоду після останньої бонусної кампанії.
;; У сценарії без бонусів весь post-baseline період є фінальним контролем.
to-report final-withdrawal?
  if current-phase != "withdrawal" [ report false ]
  if reward-cycles <= 0 [ report true ]
  report current-cycle = reward-cycles
end


;; =========================================================
;; ПОСЛІДОВНІСТЬ ДІЙ ПОКУПЦЯ
;; =========================================================
;; Послідовність одного кроку агента є явним алгоритмом:
;; 1) прийняти рішення;
;; 2) записати результат;
;; 3) оновити поведінковий стан.

to perform-shopper-step
  choose-behavior
  record-shopper-result
  update-behavioral-state
  update-satisfaction

  ;; У сценарії WOM OFF opinion не є частиною моделі прийняття рішення.
  ;; У сценарії WOM ON власний досвід спочатку формує індивідуальну
  ;; opinion, після чого вона проходить мережеве соціальне узгодження.
  if wom-on? [
    update-opinion-from-experience
  ]
end


;; =========================================================
;; МОДУЛЬ ПРИЙНЯТТЯ РІШЕННЯ ПОКУПЦЕМ
;; =========================================================

to choose-behavior
  ;; Utility визначає імовірність, а не жорсткий результат.
  set chose-target?
    random-float 1 < target-choice-probability
end


;; M1. `choice-sharpness` множить корисність перед логістичною функцією.
;; За значення 1.0 правило ідентичне v12. Приблизно вище 2.5
;; зворотний зв'язок між вибором і звичкою стає самопідсилювальним
;; для частини популяції, що породжує lock-in та інерцію.
to-report target-choice-probability
  report logistic (choice-sharpness * target-choice-utility)
end


to-report target-choice-utility
  report intrinsic-contribution
    + habit-contribution
    + reward-contribution
    + opinion-contribution
    - price-contribution
end


to-report intrinsic-contribution
  ;; Intrinsic motivation є динамічним станом, а не окремою sensitivity.
  report intrinsic-motivation
end


to-report habit-contribution
  report habit-sensitivity * habit
end


to-report reward-contribution
  report reward-sensitivity * active-reward-salience
end


to-report opinion-contribution
  ;; WOM ВИМКНЕНО:
  ;; цільовий вибір визначають ціна, внутрішня мотивація, звичка та винагорода.
  ;;
  ;; WOM УВІМКНЕНО:
  ;; satisfaction формує opinion; мережевий bounded-confidence механізм
  ;; соціально узгоджує її, після чого opinion входить у корисність вибору.
  if not wom-on? [ report 0 ]
  report opinion-weight * opinion
end


to-report price-contribution
  report price-sensitivity * target-choice-cost
end

;; Єдина точка визначення поточної політики винагороди для агента.
;; Інші модулі не звертаються до low-reward-salience/high-reward-salience напряму.
to-report active-reward-salience
  if not reward-active? [ report 0 ]

  if treatment-group = "low-salience" [
    report low-reward-salience
  ]

  if treatment-group = "high-salience" [
    report high-reward-salience
  ]

  report 0
end


;; =========================================================
;; МОДУЛЬ ПОВЕДІНКОВОГО СТАНУ
;; =========================================================
;; Цей модуль реалізує одну конкретну поведінкову модель. У майбутньому
;; сюди можна додати інші механізми без зміни Simulation Controller.

to update-behavioral-state
  update-habit-state
  update-intrinsic-motivation-state
end


to update-habit-state
  ;; Звичка є ковзною часткою цільових виборів у пам'яті агента.
  ;; Тому вона формується виключно через повторення і не потребує
  ;; окремого habit-learning-rate або habit-decay-rate.
  let current-choice ifelse-value chose-target? [1] [0]
  set recent-choice-history
    fput current-choice (but-last recent-choice-history)
  set habit mean recent-choice-history
end


to update-intrinsic-motivation-state
  ;; Мотивація змінюється лише після фактичного цільового вибору
  ;; під час активної бонусної програми для treatment-груп.
  if not reward-active? [ stop ]
  if treatment-group = "control" [ stop ]
  if not chose-target? [ stop ]

  let salience active-reward-salience

  ifelse salience <= salience-threshold [
    apply-supportive-reward salience
  ]
  [
    apply-crowding-out salience
  ]
end


to apply-supportive-reward [salience]
  ;; Підтримувальна винагорода може підтверджувати цінність поведінки.
  ;; habit-memory-window задає спільний часовий масштаб адаптації.
  let supportive-signal salience-threshold - salience
  let reinforcement
    supportive-signal
    * (1 - intrinsic-motivation)
    / habit-memory-window

  set intrinsic-motivation
    clamp (intrinsic-motivation + reinforcement) 0 1
end


to apply-crowding-out [salience]
  ;; Надмірно значуща винагорода може сприйматися як зовнішній контроль.
  ;; Сила реакції відрізняється між агентами через autonomy-sensitivity.
  let controlling-signal salience - salience-threshold
  let motivation-loss
    autonomy-sensitivity
    * controlling-signal
    * intrinsic-motivation
    / habit-memory-window

  set intrinsic-motivation
    clamp (intrinsic-motivation - motivation-loss) 0 1
end

;; =========================================================
;; МОДУЛЬ ДОСВІДУ, ДУМКИ ТА WORD-OF-MOUTH
;; =========================================================

;; Satisfaction — оцінка саме поточної покупки. Випадковий шум
;; відображає варіативність обслуговування та суб'єктивного сприйняття.
to update-satisfaction
  ;; M3. `non-target-experience` визначає, наскільки негативно
  ;; сприймається нецільова покупка. Більш негативне значення розширює
  ;; шкалу opinion і створює полюс критиків, потрібний для поділу кластерів.
  let expected-experience non-target-experience

  if chose-target? [
    set expected-experience 0.25

    ;; M5. Через цей доданок винагорода вдруге впливає на вибір:
    ;; вона підвищує satisfaction, satisfaction підвищує opinion,
    ;; а opinion входить у корисність. Перемикач вимикає цей непрямий
    ;; шлях, щоб окремо виміряти прямий ефект винагороди.
    if reward-affects-satisfaction? [
      set expected-experience expected-experience
        + 0.45 * active-reward-salience
    ]
  ]

  set satisfaction clamp
    (random-normal expected-experience 0.15)
    -1 1
end


;; Власний новий досвід поступово притягує накопичений opinion до
;; поточного satisfaction. Індивідуальний rate задає довжину пам'яті.
to update-opinion-from-experience
  set opinion clamp
    (opinion + opinion-update-rate * (satisfaction - opinion))
    -1 1
end


;; Мережеве соціальне узгодження opinion адаптує probabilistic
;; bounded-confidence dynamics із codbc_m_eps_f_beta до статичної
;; соціальної мережі.
;;
;; Повна логіка сценарію з WOM:
;; satisfaction -> індивідуальне оновлення opinion -> мережеве HK-подібне оновлення
;; -> opinion -> наступний цільовий вибір.
;;
;; Після оновлення opinion власним досвідом:
;; 1) opinions фіксуються в previous-opinion;
;; 2) кожен агент оцінює всіх безпосередніх link-neighbors;
;; 3) кожна сусідська думка приймається з імовірністю, яка залежить
;;    від розбіжності, confidence-bound, acceptance-facilitation
;;    та baseline-acceptance;
;; 4) next-opinion дорівнює середньому власної та прийнятих думок;
;; 5) нові opinions застосовуються синхронно.
to perform-social-opinion-dynamics-step
  ask shoppers [
    set previous-opinion opinion
    set next-opinion opinion
    set received-wom-count 0
    set wom-opinion-change 0
  ]

  if not wom-on? [ stop ]

  ask shoppers [
    ifelse random-float 1 < opinion-mutation-rate [
      ;; Зовнішній інформаційний шок, аналог mutation у референтній моделі.
      set next-opinion random-float 2 - 1
    ]
    [
      let focal-agent self
      let focal-opinion previous-opinion

      let accepted-neighbors link-neighbors with [
        random-float 1 <
          probability-acceptance
            (abs (previous-opinion - [previous-opinion] of focal-agent))
      ]

      set received-wom-count count accepted-neighbors

      ;; Власна думка завжди входить до множини усереднення.
      set next-opinion
        (focal-opinion + sum [previous-opinion] of accepted-neighbors)
        / (1 + received-wom-count)
    ]
  ]

  ask shoppers [
    set wom-opinion-change next-opinion - previous-opinion
    set opinion clamp next-opinion -1 1
  ]
end


;; Імовірність прийняття чужої думки.
;; acceptance-facilitation = 1 створює жорсткий bounded-confidence:
;; усередині confidence-bound імовірність дорівнює 1.
;; Менші значення формують плавне спадання імовірності з відстанню.
;; baseline-acceptance задає мінімальну імовірність прийняття,
;; зокрема для opinions за межами confidence-bound.
to-report probability-acceptance [discrepancy]
  if discrepancy > confidence-bound [
    report baseline-acceptance
  ]

  if acceptance-facilitation >= 1 [
    report 1
  ]

  if acceptance-facilitation <= 0 [
    report baseline-acceptance
  ]

  let shape-parameter
    (1 / (1 - acceptance-facilitation ^ 2)) - 1

  if shape-parameter <= 0 [
    report baseline-acceptance
  ]

  let normalized-distance discrepancy / confidence-bound
  let bounded-probability
    (1 - normalized-distance) ^ (1 / shape-parameter)

  report clamp
    (max list baseline-acceptance bounded-probability)
    0 1
end


;; Частка агентів, які прийняли хоча б одну сусідську opinion.
to-report wom-receiver-share
  if not any? shoppers [ report 0 ]
  report count shoppers with [received-wom-count > 0] / count shoppers
end


;; Середній абсолютний зсув opinion, спричинений мережевим узгодженням,
;; і негативних змін.
to-report mean-absolute-wom-opinion-change
  if not any? shoppers [ report 0 ]
  report mean [abs wom-opinion-change] of shoppers
end


;; =========================================================
;; МОДУЛЬ МЕТРИК: НАКОПИЧЕННЯ ДАНИХ
;; =========================================================

to record-shopper-result
  if not chose-target? [ stop ]

  if current-phase = "baseline" [
    set baseline-target-choices baseline-target-choices + 1
  ]

  if current-phase = "reward" [
    set reward-target-choices reward-target-choices + 1
  ]

  ;; Проміжні та фінальний withdrawal зберігаються окремо.
  ;; Це дозволяє оцінювати реакцію між кампаніями незалежно від
  ;; довгострокової стійкості після завершення всієї програми.
  if inter-cycle-withdrawal? [
    set inter-cycle-withdrawal-target-choices
      inter-cycle-withdrawal-target-choices + 1
  ]

  if final-withdrawal? [
    set final-withdrawal-target-choices
      final-withdrawal-target-choices + 1
  ]
end


to record-system-state
  if current-phase = "baseline" [
    set baseline-ticks-completed baseline-ticks-completed + 1
  ]

  if current-phase = "reward" [
    set reward-ticks-completed reward-ticks-completed + 1
  ]

  if inter-cycle-withdrawal? [
    set inter-cycle-withdrawal-ticks-completed
      inter-cycle-withdrawal-ticks-completed + 1
  ]
    
  if final-withdrawal? [
    set final-withdrawal-ticks-completed
      final-withdrawal-ticks-completed + 1
  ]
end


;; =========================================================
;; МОДУЛЬ МЕТРИК: БАЗОВІ ПОКАЗНИКИ
;; =========================================================

;; Поточна частка агентів групи, які здійснили цільовий вибір
;; на поточному tick. Reporter призначений для побудови часових
;; рядів у BehaviorSpace і не використовує накопичені фазові метрики.
to-report current-choice-rate [group-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [ report 0 ]

  report mean [
    ifelse-value chose-target? [1] [0]
  ] of selected-shoppers
end


to-report choice-rate [group-name phase-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  let group-size count selected-shoppers
  if group-size = 0 [ report 0 ]

  if phase-name = "baseline" [
    report safe-rate
      (sum [baseline-target-choices] of selected-shoppers)
      (group-size * baseline-ticks-completed)
  ]

  if phase-name = "reward" [
    report safe-rate
      (sum [reward-target-choices] of selected-shoppers)
      (group-size * reward-ticks-completed)
  ]

  if phase-name = "inter-cycle-withdrawal" [
    report safe-rate
      (sum [inter-cycle-withdrawal-target-choices] of selected-shoppers)
      (group-size * inter-cycle-withdrawal-ticks-completed)
  ]

  if phase-name = "final-withdrawal" [
    report safe-rate
      (sum [final-withdrawal-target-choices] of selected-shoppers)
      (group-size * final-withdrawal-ticks-completed)
  ]

  ;; Сумісний із попередніми версіями агрегат за всіма withdrawal-періодами.
  if phase-name = "withdrawal" [
    let target-choices
      sum [inter-cycle-withdrawal-target-choices] of selected-shoppers
      + sum [final-withdrawal-target-choices] of selected-shoppers

    let withdrawal-ticks
      inter-cycle-withdrawal-ticks-completed
      + final-withdrawal-ticks-completed

    report safe-rate target-choices (group-size * withdrawal-ticks)
  ]

  report 0
end


;; Зручні обгортки, що роблять призначення метрик явним.
to-report inter-cycle-choice-rate [group-name]
  report choice-rate group-name "inter-cycle-withdrawal"
end


to-report final-withdrawal-choice-rate [group-name]
  report choice-rate group-name "final-withdrawal"
end


;; Persistence — спостережувана частка цільових виборів у фінальному
;; withdrawal-періоді після завершення винагород. Вона показує, чи
;; зберігається цільова поведінка після припинення нарахування бонусів.
to-report persistence [group-name]
  report final-withdrawal-choice-rate group-name
end


;; Persistence Index порівнює післяпрограмну стійкість із baseline-рівнем
;; цільового вибору тієї самої групи.
;; > 0: поведінка залишається вище baseline;
;; = 0: поведінка повертається до baseline;
;; < 0: поведінка опускається нижче baseline.
to-report persistence-index [group-name]
  report persistence group-name - choice-rate group-name "baseline"
end

to-report mean-intrinsic-motivation [group-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [ report 0 ]
  report mean [intrinsic-motivation] of selected-shoppers
end


to-report mean-habit [group-name]
  let selected-shoppers shoppers with [
    treatment-group = group-name
  ]

  if not any? selected-shoppers [ report 0 ]
  report mean [habit] of selected-shoppers
end


;; =========================================================
;; МОДУЛЬ МЕТРИК: ПОХІДНІ БІЗНЕС-ПОКАЗНИКИ
;; =========================================================

;; Універсальна різниця між treatment-групою та control після бонусів.
to-report post-reward-effect [group-name]
  ;; Порівняння виконується лише у фінальному withdrawal, тобто після
  ;; завершення всієї послідовності бонусних кампаній.
  report final-withdrawal-choice-rate group-name
    - final-withdrawal-choice-rate "control"
end

;; Від'ємне значення означає crowding-out high-salience групи.
to-report high-reward-crowding-out-effect
  report post-reward-effect "high-salience"
end

;; Додатне значення означає довготривалий позитивний ефект low-salience.
to-report low-reward-persistence-effect
  report post-reward-effect "low-salience"
end


to-report withdrawal-drop [group-name]
  report choice-rate group-name "reward"
    - final-withdrawal-choice-rate group-name
end


to-report high-reward-withdrawal-drop
  report withdrawal-drop "high-salience"
end


to-report low-reward-withdrawal-drop
  report withdrawal-drop "low-salience"
end

;; Конкретні reporters залишені як стабільний зовнішній контракт моделі.
;; Загальний persistence-ratio навмисно не використовується.
to-report high-reward-retention-ratio
  report safe-rate
    (final-withdrawal-choice-rate "high-salience")
    (choice-rate "high-salience" "reward")
end


to-report low-reward-retention-ratio
  report safe-rate
    (final-withdrawal-choice-rate "low-salience")
    (choice-rate "low-salience" "reward")
end


;; Середні показники нових механізмів для UI та BehaviorSpace.
to-report mean-satisfaction [group-name]
  let group-agents shoppers with [treatment-group = group-name]
  if not any? group-agents [ report 0 ]
  report mean [satisfaction] of group-agents
end


to-report mean-opinion [group-name]
  let group-agents shoppers with [treatment-group = group-name]
  if not any? group-agents [ report 0 ]
  report mean [opinion] of group-agents
end


to-report opinion-standard-deviation
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [opinion] of shoppers
end


to-report opinion-range
  if not any? shoppers [ report 0 ]
  report max [opinion] of shoppers - min [opinion] of shoppers
end


;; Частка покупців у стані високої повторюваності цільового вибору.
;; Разом із `share-locked-out` показує, чи поділилася популяція
;; на дві стабільні поведінкові групи, що має робити можливим M1,
;; тоді як одне середнє значення цей поділ приховує.
to-report share-locked-in
  if not any? shoppers [ report 0 ]
  report count shoppers with [habit >= 0.70] / count shoppers
end


;; Частка покупців у стані низької повторюваності цільового вибору.
to-report share-locked-out
  if not any? shoppers [ report 0 ]
  report count shoppers with [habit <= 0.30] / count shoppers
end


;; Широкий розкид значень habit означає поділ популяції; вузький —
;; що всі агенти поводяться приблизно однаково.
to-report habit-standard-deviation
  if count shoppers < 2 [ report 0 ]
  report standard-deviation [habit] of shoppers
end


to-report mean-network-degree
  if not any? shoppers [ report 0 ]
  report mean [count link-neighbors] of shoppers
end


;; =========================================================
;; МОДУЛЬ ВІЗУАЛІЗАЦІЇ
;; =========================================================

to update-visualization

  ask shoppers [
    ;; X = intrinsic motivation; Y = habit strength.
    let x-position scale-value intrinsic-motivation min-pxcor max-pxcor
    let y-position scale-value habit min-pycor max-pycor

    ;; Раніше тут додавався випадковий jitter, який генерував по два
    ;; випадкові числа для кожного покупця на кожному tick як у
    ;; безінтерфейсних запусках BehaviorSpace, так і в інтерфейсі.
    ;; Це пов'язувало результати з кодом візуалізації та розміром популяції; jitter видалено.
    setxy
      clamp x-position min-pxcor max-pxcor
      clamp y-position min-pycor max-pycor

    ifelse chose-target? [
      set size 1
    ]
    [
      set size 0.55
    ]
  ]
end


to-report scale-value [value minimum maximum]
  report minimum + value * (maximum - minimum)
end


;; =========================================================
;; ДОПОМІЖНІ ФУНКЦІЇ
;; =========================================================

to-report safe-rate [numerator denominator]
  if denominator = 0 [ report 0 ]
  report numerator / denominator
end


to-report logistic [value]
  ;; Обмеження аргументу запобігає переповненню exp().
  let bounded-value clamp value -20 20
  report 1 / (1 + exp (- bounded-value))
end


to-report clamp [value minimum maximum]
  report max list minimum (min list maximum value)
end


to-report bounded-random-normal
  [mean-value deviation minimum maximum]

  report clamp
    (random-normal mean-value deviation)
    minimum
    maximum
end


;; =========================================================
;; REPORTER-ФУНКЦІЇ ЦІЛЬОВОЇ ОЦІНКИ ДЛЯ BEHAVIORSEARCH
;; =========================================================
;; Ці reporter-функції перетворюють багатокритеріальну мету політики
;; на одне скалярне значення fitness, яке BehaviorSearch може максимізувати.
;; Під час пошуку тривалість фінального withdrawal слід фіксувати.

;; Нормалізована інтенсивність/вартість винагороди у просторі пошуку.
;; Максимальна еталонна інтенсивність = 0.95 salience * 80 ticks * 4 cycles.
to-report behaviorsearch-normalized-cost
  report (high-reward-salience * reward-duration * reward-cycles)
         / (0.95 * 80 * 4)
end

;; Збалансована цільова функція політики:
;; 1) пріоритет довготривалої поведінки після withdrawal;
;; 2) урахування приросту вибору під час активних винагород;
;; 3) винагорода за збереження intrinsic motivation відносно control;
;; 4) штраф за інтенсивніші та дорожчі конфігурації кампанії.
;; Для поточної моделі очікуваний масштаб приблизно становить 0–0.35.
;; Доданок мотивації безпосередньо вимірює intrinsic motivation. Раніше
;; він зводився до `high-reward-crowding-out-effect`, тобто різниці
;; двох часток вибору; через це мотивація фактично не вимірювалася,
;; а фінальна withdrawal-частка high-salience двічі входила в ціль.
;; Слід враховувати, що мотивація control-покупців не оновлюється,
;; тому цей розрив однобічний: він може показати падіння treatment-групи
;; нижче статичного control, але не спільний тренд обох груп.
to-report behaviorsearch-fitness
  let durability persistence-index "high-salience"
  let uptake choice-rate "high-salience" "reward"
  let motivation-gap
    mean-intrinsic-motivation "high-salience"
    - mean-intrinsic-motivation "control"
  let policy-cost behaviorsearch-normalized-cost

  report durability
       + 0.20 * uptake
       + 0.50 * motivation-gap
       - 0.10 * policy-cost
end

;; Альтернативна цільова функція з жорсткішим обмеженням. Негативний
;; розрив мотивації штрафується сильніше, а позитивний не дає бонусу.
;; Використовується та сама поправка, що й у `behaviorsearch-fitness` вище.
to-report behaviorsearch-fitness-no-crowding
  let durability persistence-index "high-salience"
  let uptake choice-rate "high-salience" "reward"
  let motivation-penalty min list 0 (
    mean-intrinsic-motivation "high-salience"
    - mean-intrinsic-motivation "control")
  let policy-cost behaviorsearch-normalized-cost

  report durability
       + 0.20 * uptake
       + 1.00 * motivation-penalty
       - 0.10 * policy-cost
end]]></code>
