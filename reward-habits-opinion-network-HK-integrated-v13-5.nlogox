  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="regression-test" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed 12345
setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= experiment-end]]></exitCondition>
      <metrics>
        <metric>high-reward-crowding-out-effect</metric>
        <metric>low-reward-persistence-effect</metric>
        <metric>final-withdrawal-choice-rate "control"</metric>
        <metric>final-withdrawal-choice-rate "low-salience"</metric>
        <metric>final-withdrawal-choice-rate "high-salience"</metric>
        <metric>mean-intrinsic-motivation "high-salience"</metric>
        <metric>mean-habit "high-salience"</metric>
        <metric>persistence "control"</metric>
        <metric>persistence "low-salience"</metric>
        <metric>persistence "high-salience"</metric>
        <metric>persistence-index "control"</metric>
        <metric>persistence-index "low-salience"</metric>
        <metric>persistence-index "high-salience"</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-shoppers">
          <value value="900"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-cycles">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-duration">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal-duration">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="low-reward-salience">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="high-reward-salience">
          <value value="0.9"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="acceptance-facilitation">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="baseline-acceptance">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-mutation-rate">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="choice-sharpness">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="opinion-memory-rate">
          <value value="0.25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="non-target-experience">
          <value value="-0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reward-affects-satisfaction?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wom-on?">
          <value value="true"></value>
